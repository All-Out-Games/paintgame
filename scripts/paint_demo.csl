// Exercises the Dynamic_Canvas API as a writable character skin, Meccha
// Chameleon style: sample the final lit/postprocessed scene color, then paint
// that color onto your own character.
//
// Sampling reads any rendered scene content from the composed frame before UI.
// It is asynchronous: a click queues a read and the color arrives through the
// player's next input frame. Dynamic_Canvas is used solely for each player's
// writable painted output.
//
// Fully multiplayer: each player paints their own scene-owned canvas through
// normal predicted gameplay. Canvas pixels and attachment overrides are
// ordinary reconciled scene state, so every player sees every painted
// character and late joiners receive the current pixels at drop-in.
//
// Controls:
//   Click outside character - sample any rendered scene content and coat
//                             asynchronously on the next input frame
//   Right mouse (or E)      - sample without coating on the next input frame
//   Hold left on character  - paint details directly on your character
//   N / B                   - back to the normal look / wear the paint again
//   C                       - clear to skin color
//   X                       - debug: flood the canvas's left half red
//                             (orientation ground truth for mirror checks)

// The Mecha setup pose is about 2.08 wide x 2.34 tall with its arms extended.
// Keep texels square across that full frame; using the narrower arms-down idle
// silhouette would collapse the setup-pose arms onto the canvas edge.
SKIN_TEXELS_X :: 150;
SKIN_TEXELS_Y :: 168;

// Brush radius range (texels) for the picker's brush-size slider.
BRUSH_MIN :: 1.0;
BRUSH_MAX :: 24.0;

SCENE_SAMPLE_FILL_TAG      :: 1;
SCENE_SAMPLE_PICK_ONLY_TAG :: 2;

// The Mecha rig exposes a single paintable attachment (meccha_MC_circular on
// bone body), so there is one canvas override per player.
PAINTED_ATTACHMENT_COUNT :: 1;

// The character-space frame (setup pose, entity-local units) the paint canvas
// stretches over. These are the Spine export's actual setup-pose bounds after
// the engine's import scale, including the horizontally extended arms.
PAINT_RECT_MIN_X :: -1.0294;
PAINT_RECT_MIN_Y :: -0.0754;
PAINT_RECT_MAX_X ::  1.0488;
PAINT_RECT_MAX_Y ::  2.2620;

Paint_Undo_Pixel :: struct {
    x: s64;
    y: s64;
    color: v4;
}

begin_paint_stroke_undo :: proc(player: Player) {
    for saved: player.paint_undo_pixels {
        player.paint_undo_recorded[saved.y * SKIN_TEXELS_X + saved.x] = false;
    }
    player.paint_undo_pixels.clear();
}

record_paint_segment_undo :: proc(player: Player, skin: Dynamic_Canvas, from: v2, to: v2) {
    radius := player.brush_radius + 1.0;
    min_x := max(0, (min(from.x, to.x) - radius).(s64));
    max_x := min(SKIN_TEXELS_X - 1, (max(from.x, to.x) + radius).(s64));
    min_y := max(0, (min(from.y, to.y) - radius).(s64));
    max_y := min(SKIN_TEXELS_Y - 1, (max(from.y, to.y) + radius).(s64));
    segment := to - from;
    segment_len_sq := length_squared(segment);

    for y: min_y..max_y {
        for x: min_x..max_x {
            point := v2.{x.(float) + 0.5, y.(float) + 0.5};
            t := 0.0;
            if segment_len_sq > 0.0001 {
                t = clamp(((point.x - from.x) * segment.x + (point.y - from.y) * segment.y) / segment_len_sq, 0, 1);
            }
            closest := from + segment * t;
            if length_squared(point - closest) > radius * radius { continue; }

            index := y * SKIN_TEXELS_X + x;
            if player.paint_undo_recorded[index] { continue; }
            player.paint_undo_recorded[index] = true;
            player.paint_undo_pixels.append(Paint_Undo_Pixel.{x=x, y=y, color=skin.get_pixel(x, y)});
        }
    }
}

undo_last_paint_stroke :: proc(player: Player) {
    if player.skin_canvas == null { return; }
    for saved: player.paint_undo_pixels {
        player.skin_canvas.set_pixel(saved.x, saved.y, saved.color);
        player.paint_undo_recorded[saved.y * SKIN_TEXELS_X + saved.x] = false;
    }
    player.paint_undo_pixels.clear();
    player.was_painting = false;
}

Paint_Demo :: class : Component {
    handle_paint_input :: method(player: Player, dt: float) {
        skin := player.skin_canvas;
        if skin == null || player.animator == null { return; }
        if player.hide_seek_role == .SEEKER {
            player.was_painting = false;
            return;
        }
        mouse := get_mouse_world_position();

        // The canvas starts out as the player's skin color and is worn right
        // away - the character IS the canvas and looks normal until painted.
        // avatar_color usually arrives with the profile shortly after spawn,
        // but some accounts never get one (e.g. local test accounts whose
        // profile fetch fails), so fall back to purple after a grace period
        // instead of waiting forever.
        if !player.skin_initialized {
            player.wear_delay += dt;
            if player.avatar_color != .NONE || player.wear_delay > 2.0 {
                color := player.avatar_color;
                if color == .NONE { color = .PURPLE; }
                skin.fill(color_replace_get_color(color));
                player.skin_initialized = true;
                wear_paint(player, skin);
            }
        }

        // Player rig setup can finish after profile/skin initialization. Keep
        // retrying the requested canvas override until the animator exists;
        // otherwise a fast profile response leaves the painted canvas valid
        // but hidden behind the original rig forever.
        if player.wear_paint_enabled && player.override_ids[0] == 0 && player.animator != null {
            wear_paint(player, skin);
        }

        if !player.paint_mode {
            player.was_painting = false;
            return;
        }

        // A completed GPU sample is sticky in resimmable input, so consume
        // each monotonically increasing serial once. Only the two tags this
        // demo issues are allowed to change paint state; the sampled input is
        // client-authored and must be treated as untrusted.
        sample_color, sample_serial, sample_tag, sample_ok := player.try_get_scene_color_sample();
        if sample_ok && sample_serial > player.last_scene_sample_serial {
            player.last_scene_sample_serial = sample_serial;
            if sample_tag == SCENE_SAMPLE_FILL_TAG || sample_tag == SCENE_SAMPLE_PICK_ONLY_TAG {
                player.brush_color = sample_color;
                // Reflect the eyedropped colour in the picker knob/hue/swatch and
                // disarm the eyedropper (one pick per arm).
                sh, ss, sv := rgb_to_hsv(sample_color);
                player.picker_h = sh;
                player.picker_s = ss;
                player.picker_v = sv;
                player.eyedropper_active = false;
                if sample_tag == SCENE_SAMPLE_FILL_TAG {
                    skin.fill(sample_color);
                    if !player.skin_initialized {
                        player.skin_initialized = true;
                        wear_paint(player, skin);
                    }
                }
            }
        }

        // Press C: reset the character back to the player's skin color.
        if get_input_down(.C, false) {
            color := player.avatar_color;
            if color == .NONE { color = .PURPLE; }
            skin.fill(color_replace_get_color(color));
            player.skin_initialized = true;
        }
        // Press X: orientation ground truth - flood the left half of the
        // canvas red in texel space, for verifying the canvas-to-character
        // mapping isn't mirrored.
        if get_input_down(.X, false) {
            skin.stamp(v2.{20, 0}, v2.{20, SKIN_TEXELS_Y.(float)}, 26, v4.{0.9, 0.15, 0.15, 1}, 0.05, 1.0);
        }

        // P: toggle the colour picker. While open it suppresses scene-sampling
        // (its panel sits where you would click), but you can still paint on your
        // character with the picked colour.
        if get_input_down(.P, false) {
            player.picker_open = !player.picker_open;
        }

        // B: wear the paint again after N removed it.
        if get_input_down(.B, false) {
            player.wear_paint_enabled = true;
            if player.override_ids[0] == 0 { wear_paint(player, skin); }
        }
        // Press N: back to the normal look.
        if get_input_down(.N, false) {
            player.wear_paint_enabled = false;
            for i: 0..PAINTED_ATTACHMENT_COUNT-1 {
                if player.override_ids[i] != 0 {
                    player.animator.instance.clear_attachment_sprite_override(player.override_ids[i]);
                    player.override_ids[i] = 0;
                }
            }
        }

        left_down := get_input_down(.MOUSE_LEFT, false);
        left_held := get_input_held(.MOUSE_LEFT);

        // Eyedropper: while armed (PICK button), the next left-click samples the
        // rendered scene colour anywhere (even over the character). The result
        // arrives via try_get_scene_color_sample above, which sets the brush,
        // syncs the picker, and disarms.
        if player.eyedropper_active {
            if left_down {
                player.request_scene_color_sample(get_mouse_screen_position(), SCENE_SAMPLE_PICK_ONLY_TAG);
                player.was_painting = false;
                return;
            }
        }

        // Line tool: first click anchors, second commits. Returning early keeps
        // a click that lands off the character from being read as a scene-fill
        // sample, which would flood the whole canvas.
        if player.line_tool_active {
            if left_down && !mouse_over_paint_ui(player, get_mouse_screen_position()) {
                if player.line_anchor_set {
                    player.line_anchor_set = false;
                    paint_world_line(player, skin, player.line_anchor_world, mouse);
                } else {
                    player.line_anchor_world = mouse;
                    player.line_anchor_set = true;
                }
            }
            player.was_painting = false;
            return;
        }

        // Animated mesh inversion walks the current Spine triangles, so only do
        // it on frames where a left-button action can consume the result.
        if !player.eyedropper_active && (left_held || left_down) {
            character_px, over_character, brush_scale := try_get_brush_canvas_px(player, skin, mouse);

            // Hold left mouse over your character: paint directly on the body
            // with the current brush colour. Leaving the animated silhouette
            // falls through and clears was_painting, so re-entry cannot bridge a
            // stroke through empty setup-pose space.
            if left_held && over_character {
                from := character_px;
                if player.was_painting {
                    from = player.last_paint_px;
                } else {
                    begin_paint_stroke_undo(player);
                }
                record_paint_segment_undo(player, skin, from, character_px);
                skin.stamp(from, character_px, player.brush_radius * brush_scale, player.brush_color, 0.4, 1.0);
                player.last_paint_px = character_px;
                player.was_painting = true;
                return;
            }

            // Scene sampling clicks land where the picker panel is, so suppress
            // them while it is open. An outside click samples the composed scene.
            if !player.picker_open && left_down && !over_character {
                player.request_scene_color_sample(get_mouse_screen_position(), SCENE_SAMPLE_FILL_TAG);
                player.was_painting = false;
                return;
            }
        }

        if !player.picker_open {
            // Right mouse or E queues a pick-only sample. Use edge-triggered input
            // so holding either control cannot issue a GPU read every frame.
            if get_input_down(.MOUSE_RIGHT, false) || get_input_down(.E, false) {
                player.request_scene_color_sample(get_mouse_screen_position(), SCENE_SAMPLE_PICK_ONLY_TAG);
                player.was_painting = false;
                return;
            }
        }
        player.was_painting = false;
    }
}

brush_world_radius :: proc(player: Player) -> float {
    return player.brush_radius * ((PAINT_RECT_MAX_X - PAINT_RECT_MIN_X) / SKIN_TEXELS_X.(float)) * MECHA_RENDER_SCALE;
}

// World-space spacing between mesh probes along a committed line, and a ceiling
// on how many a single line may cost. The step only sets how precisely the paint
// stops at the silhouette edge - stamp() draws a capsule between consecutive
// probes, so a coarse step never leaves gaps in the line itself.
LINE_PROBE_STEP :: 0.03;
LINE_PROBE_MAX  :: 256;

// Walk the segment and paint only the stretches that land on the animated
// silhouette. Either endpoint may sit well off the character: a probe that
// misses just breaks the run, so a line clipping a shoulder paints the shoulder
// and nothing else. Unlike the freehand brush this uses the raw mesh test with
// no outward probing - "only on the player" means exactly on it.
//
// Every probe reads the same frame's pose, and this only runs on the commit
// click, never per-frame, so the cost lands once per line.
paint_world_line :: proc(player: Player, skin: Dynamic_Canvas, from_world: v2, to_world: v2) {
    segment := to_world - from_world;
    line_length := length(segment);
    if line_length <= 0.0001 { return; }

    steps := (line_length / LINE_PROBE_STEP).(s64) + 1;
    if steps > LINE_PROBE_MAX { steps = LINE_PROBE_MAX; }

    begin_paint_stroke_undo(player);

    have_previous := false;
    previous_px: v2;
    for i: 0..steps {
        probe := from_world + segment * (i.(float) / steps.(float));
        uv, on_character := player.animator.try_get_paint_canvas_uv(probe, skin);
        if !on_character {
            have_previous = false;
            continue;
        }
        px := v2.{uv.x * skin.width.(float), uv.y * skin.height.(float)};
        // The first probe of a run stamps a dot; the rest extend from the last
        // one, which is what keeps a run continuous without bridging a gap.
        from_px := px;
        if have_previous { from_px = previous_px; }
        record_paint_segment_undo(player, skin, from_px, px);
        skin.stamp(from_px, px, player.brush_radius, player.brush_color, 0.4, 1.0);
        previous_px = px;
        have_previous = true;
    }
}

// The canvas mapping only exists on the mesh, so a cursor just off the
// silhouette has no UV of its own. Probe outward and paint at the closest
// point the brush covers.
//
// Returns a radius scale alongside the hit: a brush whose centre sits `d` away
// from the character only overlaps it by (R - d), so the stamp has to shrink by
// the same amount. Stamping the full radius at the snapped point is what made
// a barely-touching brush splatter deep inside the body.
BRUSH_PROBE_RINGS :: 3;
BRUSH_PROBE_DIRS  :: 8;
BRUSH_MIN_SCALE   :: 0.05;

try_get_brush_canvas_px :: proc(player: Player, skin: Dynamic_Canvas, mouse: v2) -> v2, bool, float {
    uv, hit := player.animator.try_get_paint_canvas_uv(mouse, skin);
    if hit {
        return v2.{uv.x * skin.width.(float), uv.y * skin.height.(float)}, true, 1.0;
    }

    world_radius := brush_world_radius(player);
    if world_radius <= 0 { return v2.{0, 0}, false, 0.0; }

    // Walk outward so the nearest overlap wins. Only reached when the cursor
    // itself misses, so a normal stroke still costs one mesh test.
    for ring: 1..BRUSH_PROBE_RINGS {
        distance := world_radius * ring.(float) / BRUSH_PROBE_RINGS.(float);
        scale := 1.0 - distance / world_radius;
        if scale < BRUSH_MIN_SCALE { break; }
        for dir: 0..BRUSH_PROBE_DIRS - 1 {
            angle := dir.(float) / BRUSH_PROBE_DIRS.(float) * PI * 2.0;
            probe := mouse + v2.{cos(angle), sin(angle)} * distance;
            probe_uv, probe_hit := player.animator.try_get_paint_canvas_uv(probe, skin);
            if probe_hit {
                return v2.{probe_uv.x * skin.width.(float), probe_uv.y * skin.height.(float)}, true, scale;
            }
        }
    }
    return v2.{0, 0}, false, 0.0;
}

MECHA_RIG_PATH :: "Spines/MechaCharacter/mc_player_silhouette.spine";
MECHA_SKIN     :: "clean3";
MECHA_RENDER_SCALE :: 0.70;
// Each skin binds a differently-named attachment to the body slot, and
// override_attachment_canvas targets by attachment name - so this must match
// the enabled skin (clean -> meccha_MC_circular, clean3 -> meccha_MC_circular5).
MECHA_PAINT_ATTACHMENT :: "meccha_MC_circular5";

// Swap the player off the default rig onto the Mecha silhouette, then install
// its locomotion and emote layers. The engine can finish building
// player.animator after Player.ao_start, and the swapped skeleton's state
// machine may not be ready in the same frame, so each step is retried from
// ao_update and latches once done. Runs on client and server alike so the swap
// and animation state replicate.
ensure_mecha_rig :: proc(player: Player) {
    if player.animator == null { return; }
    player.animator.scale = v2.{MECHA_RENDER_SCALE, MECHA_RENDER_SCALE};

    if !player.rig_swapped {
        player.animator.set_skeleton(get_asset(Spine_Asset, MECHA_RIG_PATH));
        player.rig_swapped = true;
    }

    // Keep skin selection separate from the rig-swap latch. This makes a skin
    // change take effect for players that already existed before a hot reload.
    if !player.mecha_skin_applied {
        player.animator.disable_all_skins();
        player.animator.enable_skin(MECHA_SKIN);
        player.animator.refresh_skins();
        player.mecha_skin_applied = true;
    }

    if player.rig_swapped && !player.locomotion_ready {
        sm := player.animator.state_machine;
        if sm != null && setup_mecha_locomotion(sm) {
            player.locomotion_ready = true;
        }
    }
}

// Remote players' simulation positions advance at network snapshot cadence in
// deployed games. The engine's position-delta-based `moving` variable therefore
// pulses false between snapshots and repeatedly re-enters the run state. Keep
// the built-in layer valid via the rig's Idle / Run_Fast clips, but cover it with
// a Mecha locomotion layer driven by stable, replicated input intent instead.
// Returns false until the built-in state machine is fully initialized.
// Clears a running emote and hands the locomotion tracks back to their initial
// states. Pose clips park "main" and mecha_locomotion on __CLEAR_TRACK__ while
// mecha_pose is above zero, and only mecha_pose returning to 0 releases them -
// so the machine has to be told, not just the player field.
//
// Safe on any rig: a machine that never had the mecha variables has no emote to
// release, hence the try_get_variable guard rather than a role check.
release_mecha_emote :: proc(player: Player) {
    player.active_pose = 0;
    if player.animator == null { return; }
    sm := player.animator.state_machine;
    if sm == null { return; }
    if sm.try_get_variable("mecha_pose") == null { return; }
    sm.set_int("mecha_pose", 0);
    sm.set_bool("mecha_moving", false);
}

setup_mecha_locomotion :: proc(sm: State_Machine) -> bool {
    if sm.try_get_variable("moving") == null { return false; }
    // Idempotent on purpose: if a machine ever survives a rig swap with these
    // layers still attached, building them again would duplicate every state.
    if sm.try_get_variable("mecha_moving") != null { return true; }
    moving := sm.create_variable("mecha_moving", .BOOL);
    pose := sm.create_variable("mecha_pose", .INT);
    layer := sm.create_layer("mecha_locomotion", 3);
    idle_state := layer.create_state("Idle", true);
    run_state  := layer.create_state("Run_Fast", true);
    // Pose clips do not key every bone, so whatever plays underneath bleeds
    // through and the character still looks like it is running. Park this
    // track entirely while an emote is active. Pose 0 means "no emote", and
    // there is no NOT_EQUAL condition, hence >= 1.
    empty_state := layer.create_state("__CLEAR_TRACK__", true);
    layer.set_initial_state(idle_state);
    layer.create_transition(idle_state, run_state, false).create_bool_condition(moving, true);
    layer.create_transition(run_state, idle_state, false).create_bool_condition(moving, false);
    layer.create_global_transition(empty_state, false).create_int_condition(pose, 1, .GREATER_EQUAL);
    layer.create_transition(empty_state, idle_state, false).create_int_condition(pose, 0, .EQUAL);
    silence_built_in_locomotion_while_emoting(sm, pose);
    setup_mecha_emotes(sm, pose);
    return true;
}

// The engine's own "main" layer keeps playing Idle underneath everything, and
// its leg keys show through any pose that does not key them. Park it while an
// emote is active, then hand control back to the engine's initial state.
silence_built_in_locomotion_while_emoting :: proc(sm: State_Machine, pose: State_Machine_Variable) {
    layer := sm.try_get_layer("main");
    if layer == null { return; }
    initial := layer.get_initial_state();
    empty_state := layer.create_state("__CLEAR_TRACK__", true);
    layer.create_global_transition(empty_state, false).create_int_condition(pose, 1, .GREATER_EQUAL);
    if initial != null {
        layer.create_transition(empty_state, initial, false).create_int_condition(pose, 0, .EQUAL);
    }
}

setup_mecha_emotes :: proc(sm: State_Machine, pose: State_Machine_Variable) {
    layer := sm.create_layer("mecha_emotes", 4);
    empty := layer.create_state("__CLEAR_TRACK__", true);
    layer.set_initial_state(empty);
    layer.create_global_transition(empty, false).create_int_condition(pose, 0, .EQUAL);

    // Kept in lockstep with the labels/icons in draw_emote_menu - same order,
    // same count - so a button's grid index maps to the matching pose value.
    // Commented entries can come back by uncommenting here and there together.
    names: [4]string = {
        "pose/balancing", "pose/idle", "pose/star", "pose/t_pose",
        // "pose/ball", "pose/bend", "pose/bridge", "pose/costanza",
        // "pose/future", "pose/handstand", "pose/lying", "pose/mid_run",
        // "pose/sitting", "pose/superman", "pose/surrender", "pose/yoga"
    };
    for i: 0..names.count - 1 {
        state := layer.create_state(names[i], true);
        layer.create_global_transition(state, false).create_int_condition(pose, i + 1, .EQUAL);
    }
}

// Wear the paint: override the Mecha silhouette's single body attachment
// (meccha_MC_circular) with the canvas in skeleton-space mode, so the whole
// character is one continuous painted surface framed by the paint rect. The
// override id and canvas rect are reconciled scene state, so every client and
// late joiner renders the worn paint automatically.
wear_paint :: proc(player: Player, skin: Dynamic_Canvas) {
    if player.animator == null { return; }
    player.animator.instance.set_paint_canvas_rect(v2.{PAINT_RECT_MIN_X, PAINT_RECT_MIN_Y}, v2.{PAINT_RECT_MAX_X, PAINT_RECT_MAX_Y});
    player.override_ids[0] = player.animator.instance.override_attachment_canvas(MECHA_PAINT_ATTACHMENT, skin, true);
}

// Rubber-band from the anchor to the cursor once the first point is down.
// Without it the second click is a guess. The anchor is a fixed world point and
// the camera is parked while painting, so no interpolation is needed.
draw_paint_line_preview :: proc(player: Player) {
    if !player.line_tool_active || !player.line_anchor_set { return; }
    if !player.wear_paint_enabled || player.skin_canvas == null { return; }

    UI.push_screen_draw_context();
    defer UI.pop_draw_context();
    UI.push_layer(129);
    defer UI.pop_layer();

    start := world_to_screen(player.line_anchor_world);
    end := get_mouse_screen_position();
    white := core_globals.white_sprite;
    // Dark backing keeps the preview readable over pale paint, same as the cursor.
    UI.line(start, end, 5.0, white, v4.{0.05, 0.05, 0.06, 0.7});
    UI.line(start, end, 2.0, white, v4.{player.brush_color.x, player.brush_color.y, player.brush_color.z, 0.95});
    UI.wire_circle(start, 8.0, 3.5, v4.{0.05, 0.05, 0.06, 0.8}, 24);
    UI.wire_circle(start, 8.0, 2.0, v4.{1, 1, 1, 0.95}, 24);
}

// Screen-space brush preview. Its diameter is derived from the same
// character-space texel scale used by Dynamic_Canvas, so it matches the
// painted footprint at every camera zoom level.
draw_paint_cursor :: proc(player: Player) {
    if !player.paint_mode || !player.wear_paint_enabled || player.skin_canvas == null { return; }

    mouse := get_mouse_screen_position();
    world := screen_to_world(mouse);
    world_radius := brush_world_radius(player);
    edge_screen := world_to_screen(world + v2.{world_radius, 0});
    radius := length(edge_screen - mouse);
    radius = max(radius, 5.0);

    UI.push_screen_draw_context();
    defer UI.pop_draw_context();
    UI.push_layer(130);
    defer UI.pop_layer();
    UI.push_interpolation_offset(player.paint_cursor_interp.update(mouse));
    defer UI.pop_interpolation_offset();

    circle := get_asset(Texture_Asset, "$AO/circle.png");
    brush_rect := Rect{min=mouse - v2.{radius, radius}, max=mouse + v2.{radius, radius}};
    cursor_alpha := 0.38;
    if player.eyedropper_active { cursor_alpha = 0.55; }
    UI.quad(brush_rect, circle, v4.{player.brush_color.x, player.brush_color.y, player.brush_color.z, cursor_alpha});

    // The dark outer keyline remains readable over pale paint and the white
    // inner ring remains readable over dark paint.
    UI.wire_circle(mouse, radius + 1.5, 4.0, v4.{0.05, 0.05, 0.06, 0.8}, 48);
    UI.wire_circle(mouse, radius, 2.0, v4.{1, 1, 1, 0.95}, 48);
}

PAINT_MODE_ZOOM_T :: 1.0;

Paint_Mode_Splash :: class : Component {
    lifetime: float;

    ao_update :: method(dt: float) {
        lifetime += dt;
        if lifetime >= 0.7 { entity.destroy(); }
    }
}

play_paint_mode_splash :: proc(player: Player) {
    splash_entity := Scene.create_entity();
    splash_entity.set_parent(player.entity, false);
    splash_entity.set_local_position(v2.{0, 0.75});
    splash_entity.set_local_scale(v2.{0.42, 0.42});

    splash := splash_entity.add_component(Spine_Animator);
    splash.awaken();
    splash.set_skeleton(get_asset(Spine_Asset, "reusable_weapons/anims/reusable-weapons/water_splash/013RED_Water_Splash.spine"));
    splash.color_multiplier = player.brush_color;
    splash.layer = 20;
    splash.set_animation("013RED/Splash", false, 0);
    splash_entity.add_component(Paint_Mode_Splash);

    desc := SFX.default_sfx_desc();
    desc.entity_to_follow = player.entity.id;
    desc.specific_to_player = player;
    desc.volume = 0.55;
    desc.speed_perturb = 0.08;
    SFX.play(get_asset(SFX_Asset, "reusable_weapons/sounds/reusable-weapons/geyser_splash_02.wav"), desc);
}

draw_paint_mode_button :: proc(player: Player) {
    begin_desc := UIK.window(UI.get_safe_screen_rect());
    begin_desc.layer = 110;
    UIK.begin(begin_desc);
    defer UIK.end();

    UIK.overlay_begin(.BOTTOM_CENTER, v2.{0, 28});
    defer UIK.overlay_end();

    row := UIK.layout_row(UIK.fit(), UIK.fit(), 14);
    row.cross_align = .CENTER;
    UIK.panel_begin(row);
    defer UIK.panel_end();

    if player.hide_seek_role != .SEEKER {
        button_desc := UIK.widget_desc_button_default(.BUTTON_BASIC_GREEN);
        button_desc.panel.min_width = 190;
        button_desc.panel.min_height = 64;
        if player.paint_mode {
            button_desc = UIK.widget_desc_button_default(.BUTTON_BASIC_RED);
            button_desc.panel.min_width = 190;
            button_desc.panel.min_height = 64;
        }
        label := "Paint";
        if player.paint_mode { label = "Cancel"; }

        result := UIK.button("paint_mode_button", label, button_desc);
        if UIK.clicked(result) {
            if player.paint_mode {
                exit_paint_mode(player);
            } else {
                enter_paint_mode(player);
            }
        }

        // The round HUD runs across the top of the screen, right where the head
        // sits at paint-mode zoom. This clears it out of the way. The paint
        // controls stay up - including this button, or there would be no way back.
        if player.paint_mode {
            hide_desc := UIK.widget_desc_button_default(.BUTTON_BASIC_BLUE);
            hide_desc.panel.min_width = 190;
            hide_desc.panel.min_height = 64;
            hide_label := "Hide UI";
            if player.hide_game_ui { hide_label = "Show UI"; }
            hide_result := UIK.button("hide_game_ui_button", hide_label, hide_desc);
            if UIK.clicked(hide_result) {
                player.hide_game_ui = !player.hide_game_ui;
            }
        }
    }

}

EMOTE_BUTTON_RIGHT_INSET :: 104.0;

draw_emote_button :: proc(player: Player) {
    if player.hide_seek_role == .SEEKER { return; }

    begin_desc := UIK.window(UI.get_safe_screen_rect());
    begin_desc.layer = 110;
    UIK.begin(begin_desc);
    defer UIK.end();

    // Clears the zoom bar, which occupies the 80pt strip inset 10 from the right
    // edge (see draw_zoom_slider). Fixed rather than paint-mode only, so the
    // button does not jump sideways when the bar appears.
    UIK.overlay_begin(.CENTER_RIGHT, v2.{-EMOTE_BUTTON_RIGHT_INSET, 0});
    defer UIK.overlay_end();

    emote_desc := UIK.widget_desc_button_default(.BUTTON_BASIC_PURPLE);
    emote_desc.panel.width = UIK.pixels(150);
    emote_desc.panel.height = UIK.pixels(166);
    emote_desc.panel.axis = .VERTICAL;
    emote_desc.panel.cross_align = .CENTER;
    emote_desc.panel.main_align = .CENTER;
    emote_desc.panel.gap = 6;
    emote_desc.panel.padding = v4.{10, 12, 10, 12};
    emote_result := UIK.panel_begin_interactive("emotes_button", emote_desc.panel, false);
    icon_box := UIK.layout_column();
    icon_box.width = UIK.pixels(81);
    icon_box.height = UIK.pixels(81);
    UIK.panel_begin(icon_box);
    UIK.image_fitted(get_asset(Texture_Asset, "emotebubble.png"), UIK.image_desc(.CONTAIN));
    UIK.panel_end();
    label_desc := UIK.text_body();
    label_desc.set_halign(.CENTER);
    UIK.text(label_desc, "Emotes");
    UIK.panel_end();

    if UIK.clicked(emote_result) {
        player.emotes_open = !player.emotes_open;
    }
}

PAINT_FREEZE_REASON :: "paint_mode";

enter_paint_mode :: proc(player: Player) {
    if player.paint_mode { return; }
    player.paint_mode = true;
    player.picker_open = true;
    player.pre_paint_camera_size = player.camera.size;
    if !player.zoom_initialized && player.camera.size > 0 {
        player.zoom_base_size = player.camera.size;
        player.zoom_t = 0.5;
        player.zoom_initialized = true;
    }
    if player.zoom_initialized {
        player.pre_paint_zoom_t = player.zoom_t;
        player.zoom_t = PAINT_MODE_ZOOM_T;
        player.camera.size = player.zoom_base_size * ZOOM_MIN_MUL;
    }
    if !player.paint_controls_disabled {
        player.add_freeze_reason(PAINT_FREEZE_REASON);
        if player.device_kind == .PHONE || player.device_kind == .TABLET {
            player.add_joystick_disable_reason(PAINT_FREEZE_REASON);
        }
        player.paint_controls_disabled = true;
    }
    play_paint_mode_splash(player);
}

exit_paint_mode :: proc(player: Player) {
    player.paint_mode = false;
    player.picker_open = false;
    player.eyedropper_active = false;
    player.was_painting = false;
    player.line_tool_active = false;
    player.line_anchor_set = false;
    // Only reachable from the paint controls, so it must not outlive them.
    player.hide_game_ui = false;
    if player.paint_controls_disabled {
        player.remove_freeze_reason(PAINT_FREEZE_REASON);
        if player.device_kind == .PHONE || player.device_kind == .TABLET {
            player.remove_joystick_disable_reason(PAINT_FREEZE_REASON);
        }
        player.paint_controls_disabled = false;
    }
    if player.zoom_initialized { player.zoom_t = player.pre_paint_zoom_t; }
    if player.pre_paint_camera_size > 0 { player.camera.size = player.pre_paint_camera_size; }
}

draw_emote_menu :: proc(player: Player) {
    if !player.emotes_open { return; }

    begin_desc := UIK.modal(UI.get_safe_screen_rect(), 120, v4.{0, 0, 0, 0.58});
    UIK.begin(begin_desc);
    defer UIK.end();

    menu := UIK.panel_modal(.WHITE, UIK.pixels(760), UIK.pixels(650), 14, v4.{24, 28, 24, 28});
    menu.cross_align = .STRETCH;
    UIK.overlay_begin(.CENTER, menu);
    defer UIK.overlay_end();

    header := UIK.layout_row(UIK.flex(1), UIK.pixels(58), 12);
    header.cross_align = .CENTER;
    UIK.panel_begin(header);
    title_desc := UIK.text_title();
    title_desc.set_size_mult(1.25);
    UIK.text(title_desc, "POSES / EMOTES");
    UIK.spacer(UIK.flex(1), UIK.pixels(1));
    close_desc := UIK.widget_desc_button_default(.BUTTON_BASIC_RED);
    close_desc.panel.width = UIK.pixels(52);
    close_desc.panel.height = UIK.pixels(52);
    close_icon := get_asset(Texture_Asset, "$AO/ui/kit/Icons/misc_icons_2/exit_button_large.png");
    close_result := UIK.icon_button("close_emotes", close_icon, close_desc);
    UIK.panel_end();
    if UIK.clicked(close_result) {
        player.emotes_open = false;
        return;
    }

    UIK.grid_begin(4, 112);

    // Must stay in lockstep with the names array in setup_mecha_emotes - same
    // order, same count - so a button's grid index maps to the matching pose.
    // Commented entries can come back by uncommenting here and there together.
    labels: [4]string = {
        "Balancing", "Idle", "Star", "T Pose",
        // "Ball", "Bend", "Bridge", "Costanza", "Future",
        // "Handstand", "Lying", "Mid Run", "Sitting",
        // "Superman", "Surrender", "Yoga"
    };
    icons: [4]string = {
        "emote-icons/mc_player_silhouette-clean-pose-balancing_0.png",
        "emote-icons/mc_player_silhouette-clean-pose-idle_0.png",
        "emote-icons/mc_player_silhouette-clean-pose-star_0.png",
        "emote-icons/mc_player_silhouette-clean-pose-t_pose_0.png",
        // "emote-icons/mc_player_silhouette-clean-pose-ball_0.png",
        // "emote-icons/mc_player_silhouette-clean-pose-bend_0.png",
        // "emote-icons/mc_player_silhouette-clean-pose-bridge_0.png",
        // "emote-icons/mc_player_silhouette-clean-pose-costanza_0.png",
        // "emote-icons/mc_player_silhouette-clean-pose-future_0.png",
        // "emote-icons/mc_player_silhouette-clean-pose-handstand_0.png",
        // "emote-icons/mc_player_silhouette-clean-pose-lying_0.png",
        // "emote-icons/mc_player_silhouette-clean-pose-mid_run_0.png",
        // "emote-icons/mc_player_silhouette-clean-pose-sitting_0.png",
        // "emote-icons/mc_player_silhouette-clean-pose-superman_0.png",
        // "emote-icons/mc_player_silhouette-clean-pose-surrender_0.png",
        // "emote-icons/mc_player_silhouette-clean-pose-yoga_0.png"
    };
    pose_desc := UIK.widget_desc_button_default(.BUTTON_SHINY_BLUE);
    pose_desc.panel.width = UIK.flex(1);
    pose_desc.panel.height = UIK.pixels(104);
    for i: 0..labels.count - 1 {
        icon := get_asset(Texture_Asset, icons[i]);
        result := UIK.icon_button(labels[i], icon, pose_desc);
        if UIK.clicked(result) {
            player.active_pose = i + 1;
            player.emotes_open = false;
        }
    }
    UIK.grid_end();

    stop_desc := UIK.widget_desc_button_auto_default(.BUTTON_BASIC_RED);
    stop_desc.panel.width = UIK.flex(1);
    stop_desc.panel.height = UIK.pixels(68);
    stop := UIK.button("stop_emote", "Stop", stop_desc);
    if UIK.clicked(stop) {
        player.active_pose = 0;
        player.emotes_open = false;
    }
}

// ---- Colour picker (legacy immediate-mode UI) ----
// An HSV picker modelled on the Meccha "playerpaint" reference: a
// saturation/value box + a vertical hue bar, with a knob/marker and a swatch.
// All sizes are 1080p-reference pixels (rect methods auto-scale).

PICKER_MARGIN  :: 28.0;   // gap from the screen corner
PICKER_PAD     :: 24.3;   // picker controls are 35% larger for touch input
PICKER_SV_SIZE :: 459.0;  // SV box side
PICKER_HUE_W   :: 62.1;   // hue bar width
PICKER_GAP     :: 21.6;
PICKER_LABEL_H :: 59.4;
PICKER_BRUSH_H :: 45.9;   // brush-size slider row height
PICKER_BRUSH_LABEL_H :: 38.0;
PICKER_PICK_W  :: 148.5;  // eyedropper (PICK) button width
PICKER_TOOL_H  :: 59.4;   // LINE tool row height
SV_CELLS       :: 16;     // SV gradient resolution (cells per axis)
HUE_CELLS      :: 24;     // hue bar resolution

// Shared so the picker, the undo button that parks against it, and the line
// tool's input guard all derive from one set of numbers.
picker_panel_size :: proc() -> float, float {
    width := PICKER_PAD * 2 + PICKER_SV_SIZE + PICKER_GAP + PICKER_HUE_W;
    height := PICKER_PAD * 2 + PICKER_SV_SIZE + PICKER_GAP + PICKER_BRUSH_LABEL_H + PICKER_BRUSH_H + PICKER_GAP + PICKER_LABEL_H + PICKER_GAP + PICKER_TOOL_H;
    return width, height;
}

picker_panel_rect :: proc() -> Rect {
    panel_w, panel_h := picker_panel_size();
    return UI.get_safe_screen_rect().bottom_left_rect().grow(panel_h, panel_w, 0, 0).offset(PICKER_MARGIN, PICKER_MARGIN);
}

// The line tool accepts clicks anywhere on screen, so it has to hand back the
// regions the paint controls sit in - otherwise dragging the hue bar or hitting
// Cancel would drop a line anchor. These mirror the rects the draw procs build;
// they deliberately over-cover rather than track each widget exactly.
PICKER_UNDO_GUTTER :: 178.0;  // gap + undo button, see draw_paint_undo_button
ZOOM_RAIL_WIDTH    :: 100.0;  // the zoom bar's 80pt strip plus its 10pt inset
EMOTE_RAIL_WIDTH   :: 260.0;  // out to the far edge of the emote button
RIGHT_RAIL_HALF_H  :: 160.0;  // matches the zoom bar's half height
PAINT_BUTTON_HALF_W :: 197.0; // Cancel plus Hide UI, both 190 wide with a 14 gap
PAINT_BUTTON_H      :: 92.0;  // their height plus the 28pt offset off the bottom

point_in_rect :: proc(rect: Rect, point: v2) -> bool {
    return point.x >= rect.min.x && point.x <= rect.max.x && point.y >= rect.min.y && point.y <= rect.max.y;
}

mouse_over_paint_ui :: proc(player: Player, mouse_screen: v2) -> bool {
    screen := UI.get_safe_screen_rect();
    // Cancel, Hide UI and the zoom bar all survive Hide UI, so they block
    // whatever else is on screen.
    paint_button := screen.bottom_center_rect().grow(PAINT_BUTTON_H, PAINT_BUTTON_HALF_W, 0, PAINT_BUTTON_HALF_W);
    if point_in_rect(paint_button, mouse_screen) { return true; }
    zoom_rail := screen.right_center_rect().grow(RIGHT_RAIL_HALF_H, 0, RIGHT_RAIL_HALF_H, ZOOM_RAIL_WIDTH);
    if point_in_rect(zoom_rail, mouse_screen) { return true; }

    // The rest is hidden by Hide UI, and hidden controls must not go on eating
    // clicks aimed at the character behind them.
    if player.hide_game_ui { return false; }
    if player.picker_open {
        if point_in_rect(picker_panel_rect().grow(0, PICKER_UNDO_GUTTER, 0, 0), mouse_screen) { return true; }
    }
    emote_rail := screen.right_center_rect().grow(RIGHT_RAIL_HALF_H, 0, RIGHT_RAIL_HALF_H, EMOTE_RAIL_WIDTH);
    return point_in_rect(emote_rail, mouse_screen);
}

draw_paint_undo_button :: proc(player: Player) {
    if !player.paint_mode || !player.picker_open { return; }

    panel_w, panel_h := picker_panel_size();

    begin_desc := UIK.window(UI.get_safe_screen_rect());
    begin_desc.layer = 135;
    UIK.begin(begin_desc);
    defer UIK.end();

    undo_w := 160.0;
    undo_h := 76.0;
    undo_x := PICKER_MARGIN + panel_w + 18.0;
    undo_y := PICKER_MARGIN + (panel_h - undo_h) * 0.5;
    UIK.overlay_begin(.BOTTOM_LEFT, v2.{undo_x, undo_y});
    defer UIK.overlay_end();

    undo_desc := UIK.widget_desc_button_default(.BUTTON_BASIC_BLUE);
    undo_desc.panel.width = UIK.pixels(undo_w);
    undo_desc.panel.height = UIK.pixels(undo_h);
    undo_desc.disabled = player.paint_undo_pixels.count == 0;
    undo_desc.panel.axis = .HORIZONTAL;
    undo_desc.panel.cross_align = .CENTER;
    undo_desc.panel.main_align = .CENTER;
    undo_desc.panel.gap = 10;
    undo_result := UIK.panel_begin_interactive("undo_paint_stroke", undo_desc.panel, undo_desc.disabled);
    UIK.text(undo_desc.label_text, "Undo");
    undo_icon_box := UIK.layout_column();
    undo_icon_box.width = UIK.pixels(38);
    undo_icon_box.height = UIK.pixels(38);
    UIK.panel_begin(undo_icon_box);
    UIK.image_fitted(get_asset(Texture_Asset, "Undo Outline 256.png"), UIK.image_desc(.CONTAIN));
    UIK.panel_end();
    UIK.panel_end();
    if UIK.clicked(undo_result) {
        undo_last_paint_stroke(player);
    }
}

hsv_to_rgb :: proc(h: float, s: float, v: float, a: float = 1.0) -> v4 {
    hh := clamp(h, 0, 1) * 6.0;
    i  := hh.(s64);              // floor (hh is non-negative)
    f  := hh - i.(float);
    p  := v * (1.0 - s);
    q  := v * (1.0 - s * f);
    t  := v * (1.0 - s * (1.0 - f));
    ii := i % 6;
    if      ii == 0 { return v4.{v, t, p, a}; }
    else if ii == 1 { return v4.{q, v, p, a}; }
    else if ii == 2 { return v4.{p, v, t, a}; }
    else if ii == 3 { return v4.{p, q, v, a}; }
    else if ii == 4 { return v4.{t, p, v, a}; }
    return v4.{v, p, q, a};
}

rgb_to_hsv :: proc(c: v4) -> float, float, float {
    r := c.x; g := c.y; b := c.z;
    mx := max(r, max(g, b));
    mn := min(r, min(g, b));
    d  := mx - mn;
    h  := 0.0;
    if d > 0.00001 {
        if      mx == r { h = (g - b) / d; }
        else if mx == g { h = 2.0 + (b - r) / d; }
        else            { h = 4.0 + (r - g) / d; }
        h = h / 6.0;
        if h < 0 { h = h + 1.0; }
    }
    s := 0.0;
    if mx > 0.00001 { s = d / mx; }
    return h, s, mx;
}

picker_hit :: proc(rect: Rect, id: string) -> Interact_Result {
    bs := UI.default_button_settings();
    bs.sprite = core_globals.white_sprite;
    bs.color = v4.{0, 0, 0, 0};
    bs.hovered_color = v4.{0, 0, 0, 0};
    bs.pressed_color = v4.{0, 0, 0, 0};
    bs.disabled_color = v4.{0, 0, 0, 0};
    bs.press_scaling = 0;
    ts := UI.default_text_settings();
    UI.push_id(id);
    defer UI.pop_id();
    return UI.button(rect, bs, ts, "");
}

draw_color_picker :: proc(player: Player) {
    UI.push_screen_draw_context();
    defer UI.pop_draw_context();
    UI.push_layer(100);
    defer UI.pop_layer();

    panel := picker_panel_rect();
    UI.quad(panel, core_globals.white_sprite, v4.{0.10, 0.10, 0.13, 0.88});

    work := panel.inset(PICKER_PAD);
    tool_row := work.cut_bottom(PICKER_TOOL_H);
    work.cut_bottom(PICKER_GAP);
    label_row := work.cut_bottom(PICKER_LABEL_H);
    work.cut_bottom(PICKER_GAP);
    brush_row := work.cut_bottom(PICKER_BRUSH_H);
    brush_label_row := work.cut_bottom(PICKER_BRUSH_LABEL_H);
    work.cut_bottom(PICKER_GAP);
    hue_rect := work.cut_right(PICKER_HUE_W);
    work.cut_right(PICKER_GAP);
    sv_rect := work;

    sv := picker_hit(sv_rect, "picker_sv");
    if sv.active {
        r := sv.rect;
        player.picker_s = clamp((sv.mouse_position.x - r.min.x) / (r.max.x - r.min.x), 0, 1);
        player.picker_v = clamp((sv.mouse_position.y - r.min.y) / (r.max.y - r.min.y), 0, 1);
    }
    hue := picker_hit(hue_rect, "picker_hue");
    if hue.active {
        r := hue.rect;
        player.picker_h = clamp((hue.mouse_position.y - r.min.y) / (r.max.y - r.min.y), 0, 1);
    }
    if sv.active || hue.active {
        player.brush_color = hsv_to_rgb(player.picker_h, player.picker_s, player.picker_v, 1.0);
    }

    brush := picker_hit(brush_row, "picker_brush");
    if brush.active {
        r := brush.rect;
        f := clamp((brush.mouse_position.x - r.min.x) / (r.max.x - r.min.x), 0, 1);
        player.brush_radius = BRUSH_MIN + f * (BRUSH_MAX - BRUSH_MIN);
    }

    for yi: 0..SV_CELLS - 1 {
        for xi: 0..SV_CELLS - 1 {
            s0 := xi.(float) / SV_CELLS.(float);
            s1 := (xi + 1).(float) / SV_CELLS.(float);
            v0 := yi.(float) / SV_CELLS.(float);
            v1 := (yi + 1).(float) / SV_CELLS.(float);
            cell := sv_rect.subrect(s0, v0, s1, v1);
            UI.quad(cell, core_globals.white_sprite, hsv_to_rgb(player.picker_h, (s0 + s1) * 0.5, (v0 + v1) * 0.5, 1.0));
        }
    }
    for i: 0..HUE_CELLS - 1 {
        t0 := i.(float) / HUE_CELLS.(float);
        t1 := (i + 1).(float) / HUE_CELLS.(float);
        cell := hue_rect.subrect(0, t0, 1, t1);
        UI.quad(cell, core_globals.white_sprite, hsv_to_rgb((t0 + t1) * 0.5, 1.0, 1.0, 1.0));
    }

    knob := sv_rect.subrect(player.picker_s, player.picker_v, player.picker_s, player.picker_v);
    UI.quad(knob.grow(12), core_globals.white_sprite, v4.{0, 0, 0, 1});
    UI.quad(knob.grow(8), core_globals.white_sprite, v4.{1, 1, 1, 1});
    hm := hue_rect.subrect(0, player.picker_h, 1, player.picker_h);
    UI.quad(hm.grow(7, 7, 7, 7), core_globals.white_sprite, v4.{0, 0, 0, 1});
    UI.quad(hm.grow(3, 7, 3, 7), core_globals.white_sprite, v4.{1, 1, 1, 1});

    brush_label_ts := UI.default_text_settings();
    brush_label_ts.size = 34;
    brush_label_ts.color = v4.{1, 1, 1, 1};
    brush_label_ts.halign = .CENTER;
    brush_label_ts.valign = .CENTER;
    UI.text(brush_label_row, brush_label_ts, "Brush Size");

    brush_frac := clamp((player.brush_radius - BRUSH_MIN) / (BRUSH_MAX - BRUSH_MIN), 0, 1);
    track := brush_row.subrect(0, 0.18, 1, 0.82);
    UI.quad(track, core_globals.white_sprite, v4.{0, 0, 0, 0.55});
    UI.quad(brush_row.subrect(0, 0.18, brush_frac, 0.82), core_globals.white_sprite, v4.{0.85, 0.85, 0.9, 1});
    handle := brush_row.subrect(brush_frac, 0.5, brush_frac, 0.5);
    UI.quad(handle.grow(15), core_globals.white_sprite, v4.{0, 0, 0, 1});
    UI.quad(handle.grow(11), core_globals.white_sprite, v4.{1, 1, 1, 1});

    swatch := label_row.cut_left(PICKER_LABEL_H);
    label_row.cut_left(PICKER_GAP);
    UI.quad(swatch, core_globals.white_sprite, v4.{0, 0, 0, 1});
    UI.quad(swatch.inset(3), core_globals.white_sprite, hsv_to_rgb(player.picker_h, player.picker_s, player.picker_v, 1.0));

    pick_rect := label_row.cut_right(PICKER_PICK_W);
    label_row.cut_right(PICKER_GAP);
    pick_bs := UI.default_button_settings();
    pick_bs.color = v4.{0.30, 0.30, 0.36, 1};
    pick_bs.hovered_color = v4.{0.40, 0.40, 0.46, 1};
    pick_bs.pressed_color = v4.{0.18, 0.60, 0.28, 1};
    if player.eyedropper_active {
        pick_bs.color = v4.{0.20, 0.80, 0.35, 1};
        pick_bs.hovered_color = v4.{0.28, 0.90, 0.42, 1};
    }
    pick_ts := UI.default_text_settings();
    pick_ts.size = 35;
    pick_ts.color = v4.{1, 1, 1, 1};
    UI.push_id("picker_eyedrop");
    pick := UI.button(pick_rect, pick_bs, pick_ts, "PICK     ");
    UI.pop_id();
    pick_icon_rect := pick_rect.subrect(0.66, 0.12, 0.96, 0.88);
    UI.quad(pick_icon_rect, get_asset(Texture_Asset, "picker-color-icon.png"));
    if pick.clicked {
        player.eyedropper_active = !player.eyedropper_active;
        // The two click modes would fight over the same click.
        if player.eyedropper_active {
            player.line_tool_active = false;
            player.line_anchor_set = false;
        }
    }

    ts := UI.default_text_settings();
    ts.size = 40;
    ts.color = v4.{1, 1, 1, 1};
    ts.halign = .LEFT;
    ts.valign = .CENTER;
    UI.text(label_row, ts, `Brush: {(player.brush_radius + 0.5).(s64)}px`);

    // The label doubles as the tool's only prompt, so it has to say which click
    // comes next rather than just naming the mode.
    line_label := "LINE";
    if player.line_tool_active {
        line_label = "LINE: CLICK START";
        if player.line_anchor_set { line_label = "LINE: CLICK END"; }
    }
    line_bs := UI.default_button_settings();
    line_bs.color = v4.{0.30, 0.30, 0.36, 1};
    line_bs.hovered_color = v4.{0.40, 0.40, 0.46, 1};
    line_bs.pressed_color = v4.{0.18, 0.60, 0.28, 1};
    if player.line_tool_active {
        line_bs.color = v4.{0.20, 0.80, 0.35, 1};
        line_bs.hovered_color = v4.{0.28, 0.90, 0.42, 1};
    }
    line_ts := UI.default_text_settings();
    line_ts.size = 35;
    line_ts.color = v4.{1, 1, 1, 1};
    UI.push_id("picker_line_tool");
    line := UI.button(tool_row, line_bs, line_ts, line_label);
    UI.pop_id();
    if line.clicked {
        player.line_tool_active = !player.line_tool_active;
        player.line_anchor_set = false;
        if player.line_tool_active { player.eyedropper_active = false; }
    }
}
