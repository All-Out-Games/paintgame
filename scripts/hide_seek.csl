MIN_PLAYERS_DEFAULT :: 5;
STARTING_SEEKERS :: 2;
// Long enough that players joining an empty server can gather before the vote.
MAP_SELECT_COUNTDOWN_SECONDS :: 20.0;
MAP_SELECTION_SECONDS :: 10.0;
STARTING_GAME_SECONDS :: 5.0;
HIDE_PHASE_SECONDS :: 90.0;
HUNT_PHASE_SECONDS :: 180.0;
FOUND_FLICKER_SECONDS :: 3.0;
FOUND_FREEZE_REASON :: "hide_seek_found_flicker";
FAT_GROWTH_SECONDS :: 20.0;
FAT_MAX_STAGE :: 4;
REVEAL_SECONDS :: 20.0;
HIDER_WIN_REVEAL_SECONDS :: 10.0;
VICTORY_SCREEN_SECONDS :: 5.0;
// Value kept as-is so a reason added before a hot reload still resolves.
ROUND_NAME_REASON :: "hide_seek_hider";
HIDER_NAME_OFFSET_REASON :: "hide_seek_hider_rig";
HIDER_NAME_OFFSET :: 1.15;
SEEKER_RIG :: "$AO/streamed_character";
SEEKER_SHOTGUN_TEXTURE :: "shotgun-color.png";
SEEKER_WEAPON_SLOT :: "weapon_held";
TOTAL_MAP_COUNT :: 5;
VOTE_CARD_COUNT :: 3;
MAP_VOTE_HOLD_SECONDS :: 0.6;
MAP_CARD_WIDTH :: 420.0;
MAP_PREVIEW_WIDTH :: 396.0;
MAP_PREVIEW_HEIGHT :: 234.0;
MAP_VOTE_GREEN :: v4.{0.25, 1.0, 0.45, 1.0};
MAP_VOTE_TRACK_COLOR :: v4.{0.06, 0.06, 0.08, 1.0};
MAP_VOTE_BAR_HEIGHT :: 34.0;
MAP_VOTE_BAR_INSET :: 5.0;
// Seekers draw over hiders.
HIDER_ANIMATOR_LAYER :: 1;
SEEKER_ANIMATOR_LAYER :: 2;

// Hiders earn points for every second a seeker is within this radius. The
// score itself ticks continuously, but the board players see only refreshes
// on LEADERBOARD_PUBLISH_SECONDS.
SCORE_RADIUS :: 2.0;
DEFAULT_POINTS_PER_SECOND :: 1;
LEADERBOARD_PUBLISH_SECONDS :: 20.0;
LEADERBOARD_MAX_ROWS :: 8;
HUD_YELLOW :: v4.{1.0, 0.85, 0.2, 1.0};
SEEKER_WINS_LEADERBOARD :: "top_seeker_wins";
HIDER_WINS_LEADERBOARD :: "top_hider_wins";

// Every hider is whistled automatically on this cadence, so camping a corner
// in silence is not viable.
FORCED_WHISTLE_SECONDS :: 30.0;
ROLE_REVEAL_SECONDS :: 10.0;

Hide_Seek_Role :: enum {
    NONE;
    HIDER;
    SEEKER;
    // Joined while a round was already running. Waits in the lobby until they
    // opt into the hunt with the Play as Seeker button, or the round ends.
    LOBBY;
}

Map_Kind :: enum {
    BACKROOMS;
    BACKROOMS_DARK;
    BACKROOMS_WATER;
    ART_HEIST;
    CITY;
}

Hide_Seek_Phase :: enum {
    WAITING_FOR_PLAYERS;
    STARTING_MAP_SELECTION;
    MAP_SELECTION;
    STARTING_GAME;
    HIDING;
    HUNTING;
    REVEAL;
}

Hide_Seek_Winner :: enum {
    NONE;
    SEEKERS;
    HIDERS;
}

map_display_name :: proc(map: Map_Kind) -> string {
    switch map {
        case .BACKROOMS:       return "Backrooms";
        case .BACKROOMS_DARK:  return "Maze";
        case .BACKROOMS_WATER: return "Pool Room";
        case .ART_HEIST:       return "Museum";
        case .CITY:            return "City";
        default:               return "Unknown";
    }
}

// The vote card title as two fixed lines so every card is the same height and
// nothing wraps unpredictably or clips. The names all share "Backrooms"; the
// second line is the variant, or a space to hold the line when there is none.
map_name_lines :: proc(map: Map_Kind) -> string, string {
    switch map {
        case .BACKROOMS:       return "Backrooms", " ";
        case .BACKROOMS_DARK:  return "Maze", " ";
        case .BACKROOMS_WATER: return "Pool Room", " ";
        case .ART_HEIST:       return "Museum", " ";
        case .CITY:            return "City", " ";
        default:               return "Unknown", " ";
    }
}

// Placeholder art: each map preview is a flat tinted box until real map
// screenshots exist.
map_preview_tint :: proc(map: Map_Kind) -> v4 {
    switch map {
        case .BACKROOMS:       return v4.{0.86, 0.78, 0.36, 1};
        case .BACKROOMS_DARK:  return v4.{0.24, 0.26, 0.34, 1};
        case .BACKROOMS_WATER: return v4.{0.26, 0.56, 0.86, 1};
        case .ART_HEIST:       return v4.{0.78, 0.28, 0.24, 1};
        case .CITY:            return v4.{0.32, 0.48, 0.62, 1};
        default:               return v4.{1, 1, 1, 1};
    }
}

Hide_Seek_Game :: class : Component {
    lobby_spawn: Entity   @ao_serialize;
    map_spawns:  [..]Entity @ao_serialize;
    city_map_spawns: [..]Entity @ao_serialize;
    min_players: s64      @ao_serialize;
    points_per_second: s64 @ao_serialize;

    phase: Hide_Seek_Phase;
    phase_end_time: float;
    hiders_left: s64;
    seekers: s64;
    winner: Hide_Seek_Winner;
    selected_map: Map_Kind;
    map_votes: [TOTAL_MAP_COUNT]s64;
    vote_map_indices: [VOTE_CARD_COUNT]s64;
    previous_vote_map_indices: [VOTE_CARD_COUNT]s64;
    next_publish_time: float;
    next_forced_whistle_time: float;
    found_feed_start_time: float;
    found_feed_end_time: float;
    found_feed_seeker_name: string;
    found_feed_hider_name: string;
    found_feed_seeker_color: v4;
    found_feed_hider_color: v4;
    role_rng: u64;
    // True between the roles being dealt and the last reel landing. The round
    // clock and scoring are held off until it clears.
    round_start_pending: bool;
    debug_vote_active: bool;
    game_mode: Hide_Seek_Game_Mode;

    ao_start :: method() {
        g_hide_seek = this;
        // Priority 0 means "send me players": between rounds this server wants
        // to fill up. It rises to 1 while a round is live so matchmaking prefers
        // a lobby that has not started yet - see start/finish_hide_seek_round.
        Server.set_matchmaking_priority(0);
        phase = .WAITING_FOR_PLAYERS;
        role_rng = rng_root_seed();
        game_mode = .INFECTED;
        for i: 0..VOTE_CARD_COUNT - 1 {
            vote_map_indices[i] = -1;
            previous_vote_map_indices[i] = -1;
        }
        // The round needs a seeker plus at least one hider, so 2 is the floor
        // regardless of what the scene asks for.
        // The round needs a seeker plus at least one hider, so 2 is the floor
        // regardless of what the scene asks for.
        if min_players < MIN_PLAYERS_DEFAULT { min_players = MIN_PLAYERS_DEFAULT; }
        if points_per_second <= 0 { points_per_second = DEFAULT_POINTS_PER_SECOND; }
    }

    ao_update :: method(dt: float) {
        player_count := 0;
        for player: component_iterator(Player) { player_count += 1; }

        if phase == .HIDING || phase == .HUNTING {
            if round_start_pending {
                // The clock is pinned at its full value while reels are still
                // spinning, then released the frame the last one lands.
                phase_end_time = get_time() + HIDE_PHASE_SECONDS;
                if hide_seek_all_rolls_revealed() { round_start_pending = false; }
            }
            for player: component_iterator(Player) {
                if player.hide_seek_role == .NONE {
                    add_mid_round_waiter(this, player);
                }
                apply_pending_round_teleport(this, player);
                if phase == .HUNTING && player.hide_seek_role == .HIDER && player.pending_found_end_time > 0 && get_time() >= player.pending_found_end_time {
                    player.pending_found_end_time = 0;
                    convert_hider_to_seeker(this, player);
                }
                if phase == .HUNTING && game_mode == .FAT && player.hide_seek_role == .HIDER && player.fat_stage < FAT_MAX_STAGE && get_time() >= player.next_fat_time {
                    grow_fat_hider(player);
                    player.next_fat_time = get_time() + FAT_GROWTH_SECONDS;
                }
            }
            refresh_hide_seek_counts(this);
            // No scoring while the roll is running: nobody has been teleported
            // yet, so every hider would be banking proximity points off seekers
            // standing next to them in the lobby.
            if !round_start_pending { award_proximity_points(this, dt); }
            if phase == .HUNTING && get_time() >= next_forced_whistle_time {
                next_forced_whistle_time = get_time() + FORCED_WHISTLE_SECONDS;
                force_all_hiders_whistle(this);
            }
            if get_time() >= next_publish_time {
                next_publish_time = get_time() + LEADERBOARD_PUBLISH_SECONDS;
                publish_leaderboard(this);
            }
            if seekers <= 0 {
                finish_hide_seek_round(this, .HIDERS);
                return;
            }
        } else {
            // Players spawn wherever the engine drops them, so put anyone who
            // has not been placed yet into the lobby. Mid-round joiners are
            // positioned by add_mid_round_seeker instead.
            for player: component_iterator(Player) {
                if !player.spawn_placed {
                    player.spawn_placed = true;
                    teleport_player_to_lobby(this, player);
                }
            }
        }

        switch phase {
            case .WAITING_FOR_PLAYERS: {
                if player_count >= min_players {
                    phase = .STARTING_MAP_SELECTION;
                    phase_end_time = get_time() + MAP_SELECT_COUNTDOWN_SECONDS;
                }
            }
            case .STARTING_MAP_SELECTION: {
                if player_count < min_players {
                    phase = .WAITING_FOR_PLAYERS;
                } else if get_time() >= phase_end_time {
                    begin_map_selection(this);
                }
            }
            case .MAP_SELECTION: {
                if player_count < min_players && !debug_vote_active {
                    phase = .WAITING_FOR_PLAYERS;
                } else {
                    // Retallied every frame so the vote counts on the cards
                    // update live as players click.
                    tally_map_votes(this);
                    if get_time() >= phase_end_time {
                        debug_vote_active = false;
                        selected_map = resolve_map_vote(this);
                        phase = .STARTING_GAME;
                        phase_end_time = get_time() + STARTING_GAME_SECONDS;
                    }
                }
            }
            case .STARTING_GAME: {
                if player_count < min_players {
                    phase = .WAITING_FOR_PLAYERS;
                } else if get_time() >= phase_end_time {
                    start_hide_seek_round(this);
                }
            }
            case .HIDING: {
                if get_time() >= phase_end_time {
                    begin_hide_seek_hunt(this);
                }
            }
            case .HUNTING: {
                if hiders_left <= 0 {
                    finish_hide_seek_round(this, .SEEKERS);
                } else if get_time() >= phase_end_time {
                    finish_hide_seek_round(this, .HIDERS);
                }
            }
            case .REVEAL: {
                if get_time() >= phase_end_time {
                    return_players_to_lobby(this);
                }
            }
        }
    }
}

g_hide_seek: Hide_Seek_Game;

get_hide_seek_game :: proc() -> Hide_Seek_Game {
    if #alive(g_hide_seek) { return g_hide_seek; }
    for game: component_iterator(Hide_Seek_Game) {
        g_hide_seek = game;
        return game;
    }
    return null;
}

// Falls back to the position the engine spawned the player at, so an
// unassigned lobby_spawn degrades instead of dumping everyone at the origin.
lobby_position_for :: proc(game: Hide_Seek_Game, player: Player) -> v2 {
    if #alive(game.lobby_spawn) { return game.lobby_spawn.world_position; }
    return player.lobby_start_position;
}

teleport_player_to_lobby :: proc(game: Hide_Seek_Game, player: Player) {
    player.entity.set_world_position(lobby_position_for(game, player));
    player.entity.mark_teleported();
}

teleport_player_to_map :: proc(game: Hide_Seek_Game, player: Player) {
    if game.selected_map == .CITY {
        if game.city_map_spawns.count == 0 { return; }
        city_spawn_index := rng_range_int(ref game.role_rng, 0, game.city_map_spawns.count - 1);
        city_spawn := game.city_map_spawns[city_spawn_index];
        if !#alive(city_spawn) { return; }
        player.entity.set_world_position(city_spawn.world_position);
        player.entity.mark_teleported();
        return;
    }
    index := game.selected_map.(s64);
    if index < 0 || index >= game.map_spawns.count { return; }
    spawn := game.map_spawns[index];
    if !#alive(spawn) { return; }
    player.entity.set_world_position(spawn.world_position);
    player.entity.mark_teleported();
}

tally_map_votes :: proc(game: Hide_Seek_Game) {
    for i: 0..TOTAL_MAP_COUNT - 1 { game.map_votes[i] = 0; }
    for player: component_iterator(Player) {
        if map_is_in_current_vote(game, player.map_vote) {
            game.map_votes[player.map_vote] += 1;
        }
    }
}

map_is_in_current_vote :: proc(game: Hide_Seek_Game, map_index: s64) -> bool {
    for i: 0..VOTE_CARD_COUNT - 1 {
        if game.vote_map_indices[i] == map_index { return true; }
    }
    return false;
}

choose_vote_maps :: proc(game: Hide_Seek_Game) {
    attempts := 0;
    while attempts < 8 {
        chosen := 0;
        while chosen < VOTE_CARD_COUNT {
            candidate := rng_range_int(ref game.role_rng, 0, TOTAL_MAP_COUNT - 1);
            duplicate := false;
            if chosen > 0 {
                for i: 0..chosen - 1 {
                    if game.vote_map_indices[i] == candidate { duplicate = true; }
                }
            }
            if duplicate { continue; }
            game.vote_map_indices[chosen] = candidate;
            chosen += 1;
        }

        same_as_previous := true;
        for i: 0..VOTE_CARD_COUNT - 1 {
            found_previous := false;
            for j: 0..VOTE_CARD_COUNT - 1 {
                if game.vote_map_indices[i] == game.previous_vote_map_indices[j] {
                    found_previous = true;
                }
            }
            if !found_previous { same_as_previous = false; }
        }
        if !same_as_previous { break; }
        attempts += 1;
    }

    for i: 0..VOTE_CARD_COUNT - 1 {
        game.previous_vote_map_indices[i] = game.vote_map_indices[i];
    }
}

begin_map_selection :: proc(game: Hide_Seek_Game) {
    game.debug_vote_active = false;
    choose_vote_maps(game);
    for player: component_iterator(Player) {
        player.map_vote = -1;
        player.map_vote_hold_index = -1;
        player.map_vote_hold_t = 0;
    }
    tally_map_votes(game);
    game.phase = .MAP_SELECTION;
    game.phase_end_time = get_time() + MAP_SELECTION_SECONDS;
}

Hide_Seek_Game_Mode :: enum {
    INFECTED;
    FAT;
}

vote :: proc(command_player: Player) {
    game := get_hide_seek_game();
    if !#alive(game) { return; }
    begin_map_selection(game);
    game.debug_vote_active = true;
} @chat_command @owner_or_editor

// Ties (including nobody voting) break randomly among the leaders.
resolve_map_vote :: proc(game: Hide_Seek_Game) -> Map_Kind {
    tally_map_votes(game);
    first_map := game.vote_map_indices[0];
    best_votes := game.map_votes[first_map];
    for slot: 1..VOTE_CARD_COUNT - 1 {
        map_index := game.vote_map_indices[slot];
        if game.map_votes[map_index] > best_votes { best_votes = game.map_votes[map_index]; }
    }
    tied: [..]s64;
    for slot: 0..VOTE_CARD_COUNT - 1 {
        map_index := game.vote_map_indices[slot];
        if game.map_votes[map_index] == best_votes { tied.append(map_index); }
    }
    if tied.count == 1 { return tied[0].(Map_Kind); }
    rng := rng_root_seed();
    return tied[rng_range_int(ref rng, 0, tied.count - 1)].(Map_Kind);
}

// No nameplate renders while a round is live, whatever the role: hiders stay
// anonymous, and a floating seeker name would give the hunt away from across
// the map. Names come back in the lobby.
hide_round_name :: proc(player: Player) {
    if player.name_hidden { return; }
    player.add_name_invisibility_reason(ROUND_NAME_REASON);
    player.name_hidden = true;
}

show_round_name :: proc(player: Player) {
    if !player.name_hidden { return; }
    player.remove_name_invisibility_reason(ROUND_NAME_REASON);
    player.name_hidden = false;
}

// Drawn inside the bottom-center column in draw_paint_mode_button, above the
// Paint/Emotes/Whistle row. Panels only - opening a window or overlay here would
// nest inside that column's scope.
draw_play_as_seeker_button :: proc(player: Player) {
    if !hide_seek_can_join_as_seeker(player) { return; }

    join_desc := UIK.widget_desc_button_default(.BUTTON_BASIC_RED);
    join_desc.panel.width = UIK.pixels(346);
    join_desc.panel.height = UIK.pixels(72);
    join_desc.panel.axis = .HORIZONTAL;
    join_desc.panel.cross_align = .CENTER;
    join_desc.panel.main_align = .CENTER;
    join_desc.panel.gap = 12;
    join_desc.panel.padding = v4.{8, 16, 8, 16};
    join_result := UIK.panel_begin_interactive("play_as_seeker_button", join_desc.panel);

    icon_box := UIK.layout_column();
    icon_box.width = UIK.pixels(44);
    icon_box.height = UIK.pixels(44);
    UIK.panel_begin(icon_box);
    UIK.image_fitted(get_asset(Texture_Asset, "magnifying_glass_icon.png"), UIK.image_desc(.CONTAIN));
    UIK.panel_end();

    label_desc := UIK.text_title();
    label_desc.set_size_mult(0.75);
    label_desc.set_halign(.CENTER);
    label_desc.set_color(v4.{1, 1, 1, 1});
    label_desc.set_outline(true, 3.0, v4.{0, 0, 0, 1});
    UIK.text(label_desc, "Play as Seeker");
    UIK.panel_end();

    if UIK.clicked(join_result) {
        join_hide_seek_as_seeker(player);
    }
}

// True while a lobby waiter can still opt into the running round.
hide_seek_can_join_as_seeker :: proc(player: Player) -> bool {
    if player.hide_seek_role != .LOBBY { return false; }
    game := get_hide_seek_game();
    if !#alive(game) { return false; }
    return game.phase == .HIDING || game.phase == .HUNTING;
}

join_hide_seek_as_seeker :: proc(player: Player) {
    game := get_hide_seek_game();
    if !#alive(game) { return; }
    if game.phase != .HIDING && game.phase != .HUNTING { return; }
    add_mid_round_seeker(game, player, game.phase == .HIDING);
    refresh_hide_seek_counts(game);

    desc := SFX.default_sfx_desc();
    desc.specific_to_player = player;
    desc.volume = 0.8;
    desc.speed_perturb = 0;
    SFX.play(get_asset(SFX_Asset, "bell-ding_b7781f.wav"), desc);
}

// Mid-round joiners land here instead of being drafted straight into the hunt.
// They keep their nameplate and sit in the lobby, free to paint and emote, until
// they choose to join as a seeker or the round ends and rolls them into the next.
add_mid_round_waiter :: proc(game: Hide_Seek_Game, player: Player) {
    player.hide_seek_role = .LOBBY;
    player.pending_round_teleport = false;
    player.pending_found_end_time = 0;
    player.fat_stage = 0;
    player.next_fat_time = 0;
    clear_found_freeze(player);
    // Their body is dimmed out for everyone in the round (see apply_hider_stealth);
    // a floating nameplate over nothing would give that away. Restored by
    // return_players_to_lobby when the round ends.
    hide_round_name(player);
    exit_paint_mode(player);
    player.emotes_open = false;
    player.active_pose = 0;
    player.role_visual_applied = .NONE;
    player.seeker_rig_ready = false;
    player.streamed_seeker_rig_ready = false;
    player.spawn_placed = true;
    teleport_player_to_lobby(game, player);
}

add_mid_round_seeker :: proc(game: Hide_Seek_Game, player: Player, hide_phase: bool) {
    player.hide_seek_role = .SEEKER;
    player.pending_found_end_time = 0;
    player.fat_stage = 0;
    player.next_fat_time = 0;
    clear_found_freeze(player);
    hide_round_name(player);
    exit_paint_mode(player);
    player.emotes_open = false;
    player.active_pose = 0;
    player.role_visual_applied = .NONE;
    player.seeker_rig_ready = false;
    player.streamed_seeker_rig_ready = false;
    player.role_reveal_end_time = get_time() + ROLE_REVEAL_SECONDS;
    trigger_role_roll(player);
    player.spawn_placed = true;
    // Same as a round start: placed once their reel lands, by whatever phase is
    // running at that moment.
    player.pending_round_teleport = true;
}

// Moves a player into position the moment their reel has landed and held on the
// result. Destination is read from the live phase rather than captured at roll
// time, so a roll that spans the hiding/hunting flip still lands correctly.
apply_pending_round_teleport :: proc(game: Hide_Seek_Game, player: Player) {
    if !player.pending_round_teleport { return; }
    if !role_reel_revealed(player) { return; }
    player.pending_round_teleport = false;
    if player.hide_seek_role == .SEEKER && game.phase == .HIDING {
        teleport_player_to_lobby(game, player);
    } else {
        teleport_player_to_map(game, player);
    }
}

// A hider banks points for every whole second a seeker spends inside
// SCORE_RADIUS. Partial seconds are kept rather than reset, so repeatedly
// dipping in and out of range still pays out.
award_proximity_points :: proc(game: Hide_Seek_Game, dt: float) {
    for hider: component_iterator(Player) {
        if hider.hide_seek_role != .HIDER { continue; }
        near := false;
        for seeker: component_iterator(Player) {
            if seeker.hide_seek_role != .SEEKER { continue; }
            offset := seeker.entity.world_position - hider.entity.world_position;
            if length_squared(offset) <= SCORE_RADIUS * SCORE_RADIUS {
                near = true;
                break;
            }
        }
        if !near { continue; }
        hider.proximity_timer += dt;
        while hider.proximity_timer >= 1.0 {
            hider.proximity_timer -= 1.0;
            hider.score += game.points_per_second;
        }
    }
}

force_all_hiders_whistle :: proc(game: Hide_Seek_Game) {
    for player: component_iterator(Player) {
        if player.hide_seek_role != .HIDER { continue; }
        blow_whistle(player);
    }
}

// Copies the live score onto the value the board renders. Scores tick every
// frame; players only see them move on this cadence.
publish_leaderboard :: proc(game: Hide_Seek_Game) {
    for player: component_iterator(Player) {
        player.published_score = player.score;
    }
}

reset_hide_seek_scores :: proc(game: Hide_Seek_Game) {
    for player: component_iterator(Player) {
        player.score = 0;
        player.published_score = 0;
        player.proximity_timer = 0;
    }
    game.next_publish_time = get_time() + LEADERBOARD_PUBLISH_SECONDS;
}

refresh_hide_seek_counts :: proc(game: Hide_Seek_Game) {
    game.hiders_left = 0;
    game.seekers = 0;
    for player: component_iterator(Player) {
        if player.hide_seek_role == .HIDER { game.hiders_left += 1; }
        if player.hide_seek_role == .SEEKER { game.seekers += 1; }
    }
}

finish_hide_seek_round :: proc(game: Hide_Seek_Game, winner: Hide_Seek_Winner) {
    game.winner = winner;
    game.round_start_pending = false;
    game.phase = .REVEAL;
    game.phase_end_time = get_time() + VICTORY_SCREEN_SECONDS;
    // Round over - this server is a good landing spot again.
    Server.set_matchmaking_priority(0);
    for player: component_iterator(Player) {
        if winner == .SEEKERS && player.hide_seek_role == .SEEKER {
            Global_Leaderboard.increment_score(player, SEEKER_WINS_LEADERBOARD, 1);
        } else if winner == .HIDERS && player.hide_seek_role == .HIDER {
            Global_Leaderboard.increment_score(player, HIDER_WINS_LEADERBOARD, 1);
        }
    }
    // Show the true final tally during the reveal instead of a stale snapshot.
    publish_leaderboard(game);
}

return_players_to_lobby :: proc(game: Hide_Seek_Game) {
    for player: component_iterator(Player) {
        player.hide_seek_role = .HIDER;
        show_round_name(player);
        player.role_visual_applied = .NONE;
        // A reel that never finished must not drag someone out of the lobby.
        player.pending_round_teleport = false;
        player.found_banner_end_time = 0;
        player.pending_found_end_time = 0;
        clear_found_freeze(player);
        player.seeker_rig_ready = false;
        player.streamed_seeker_rig_ready = false;
        player.active_pose = 0;
        player.map_vote = -1;
        player.map_vote_hold_index = -1;
        player.map_vote_hold_t = 0;
        player.spawn_placed = true;
        exit_paint_mode(player);
        player.emotes_open = false;
        // Nothing from the round follows players into the lobby: effects,
        // a half-aimed ability, its aim IK, or any running cooldown.
        remove_all_effects(player.entity);
        player.active_ability = null;
        player.set_mouse_ik_enabled(false);
        for i: 0..player.abilities.count - 1 {
            player.abilities[i].current_cooldown = 0;
        }
        teleport_player_to_lobby(game, player);
    }
    // The bodies belonged to the round that just ended.
    clear_hide_seek_corpses();
    game.hiders_left = 0;
    game.seekers = 0;
    game.winner = .NONE;
    game.phase = .WAITING_FOR_PLAYERS;
    game.phase_end_time = 0;
}

// Hiders must not see other hiders: a hider who learns the hiding spots would
// walk straight to them the moment they are caught and turn seeker. This is a
// per-VIEWER effect - the same hider is hidden from hiders but plainly visible
// to seekers - so it cannot use add_invisibility_reason (which hides a player
// from everyone). Instead each client's local player dims the others' animators
// itself. It runs under is_local() every frame and stores nothing, because the
// server wipes local cosmetic state on each reconcile; re-applying keeps it on.
REVEAL_PULSE_SPEED :: 7.0;
REVEAL_PULSE_RED :: v4.{1.0, 0.12, 0.12, 1.0};

// During REVEAL every surviving hider flashes red so the whole lobby can see
// where they were hiding. Unlike the stealth dimming this is a GLOBAL effect,
// not per-viewer, so it runs from each player's own update on every client (P's
// lifecycle runs everywhere) rather than from the local viewer. It only ever
// touches the animator's colour channels; the alpha is left to the stealth pass
// and the two never fight - stealth is inactive in REVEAL, pulse is inactive in
// the round. Outside REVEAL it resets rgb to white so no red tint lingers.
update_reveal_pulse :: proc(player: Player) {
    if player.animator == null { return; }
    game := get_hide_seek_game();
    if player.pending_found_end_time > get_time() && player.hide_seek_role == .HIDER {
        t := (sin(get_time() * 18.0) + 1.0) * 0.5;
        player.animator.color_multiplier = v4.{1.0, lerp(1.0, 0.18, t), lerp(1.0, 0.18, t), 1.0};
    } else if #alive(game) && game.phase == .REVEAL && player.hide_seek_role == .HIDER {
        t := (sin(get_time() * REVEAL_PULSE_SPEED) + 1.0) * 0.5;
        r := lerp(1.0, REVEAL_PULSE_RED.x, t);
        g := lerp(1.0, REVEAL_PULSE_RED.y, t);
        b := lerp(1.0, REVEAL_PULSE_RED.z, t);
        player.animator.color_multiplier = v4.{r, g, b, 1.0};
    } else {
        c := player.animator.color_multiplier;
        c.x = 1.0; c.y = 1.0; c.z = 1.0;
        player.animator.color_multiplier = c;
    }
}

apply_hider_stealth :: proc(local: Player) {
    // Only a hider mid-round is blind to fellow hiders. Otherwise everyone is
    // visible (seekers must see hiders; the lobby shows everyone).
    blind := local.hide_seek_role == .HIDER && hide_seek_round_active();
    // Players who joined mid-round are standing in the lobby doing nothing. A
    // seeker waiting out the hide phase shares that lobby, so an idle stranger
    // there reads as a hider who failed to teleport. Hidden from anyone actually
    // in the round; lobby waiters still see each other.
    in_round := (local.hide_seek_role == .HIDER || local.hide_seek_role == .SEEKER) && hide_seek_round_active();
    for other: component_iterator(Player) {
        if other.entity.id == local.entity.id { continue; }
        if other.animator == null { continue; }
        c := other.animator.color_multiplier;
        caught_flickering := other.pending_found_end_time > get_time();
        hide_other := blind && other.hide_seek_role == .HIDER && !caught_flickering;
        if in_round && other.hide_seek_role == .LOBBY { hide_other = true; }
        if hide_other {
            c.w = 0;
        } else {
            c.w = 1;
        }
        other.animator.color_multiplier = c;
    }
}

hide_seek_can_shoot :: proc() -> bool {
    game := get_hide_seek_game();
    return #alive(game) && game.phase == .HUNTING;
}

hide_seek_round_active :: proc() -> bool {
    game := get_hide_seek_game();
    return #alive(game) && (game.phase == .HIDING || game.phase == .HUNTING);
}

hide_seek_whistles_active :: proc() -> bool {
    game := get_hide_seek_game();
    return #alive(game) && game.phase == .HUNTING;
}

hide_seek_voting_focus_active :: proc() -> bool {
    game := get_hide_seek_game();
    return #alive(game) && game.phase == .MAP_SELECTION;
}

update_countdown_tick_sound :: proc(player: Player) {
    game := get_hide_seek_game();
    if !#alive(game) { return; }

    active_timer := game.phase == .HIDING || game.phase == .HUNTING;
    if !active_timer {
        player.last_countdown_tick_phase = game.phase;
        player.last_countdown_tick_second = -1;
        return;
    }

    if player.last_countdown_tick_phase != game.phase {
        player.last_countdown_tick_phase = game.phase;
        player.last_countdown_tick_second = -1;
    }

    seconds := max(0.0, game.phase_end_time - get_time()).(s64);
    if seconds > 10 || seconds <= 0 {
        player.last_countdown_tick_second = seconds;
        return;
    }
    if seconds == player.last_countdown_tick_second { return; }
    player.last_countdown_tick_second = seconds;

    desc := SFX.default_sfx_desc();
    desc.specific_to_player = player;
    desc.volume = 0.65;
    desc.speed_perturb = 0;
    SFX.play(get_asset(SFX_Asset, "mouse_click_cee011.wav"), desc);
}

start_hide_seek_round :: proc(game: Hide_Seek_Game, bypass_minimum: bool = false, mode: Hide_Seek_Game_Mode = .INFECTED) -> bool {
    players: [..]Player;
    for player: component_iterator(Player) {
        if #alive(player) && #alive(player.entity) { players.append(player); }
    }
    required_players := max(game.min_players, MIN_PLAYERS_DEFAULT);
    if !bypass_minimum && players.count < required_players { return false; }
    if players.count == 0 { return false; }
    game.game_mode = mode;

    // Clear last round's bodies in case this start skipped the reveal (e.g. /start).
    clear_hide_seek_corpses();

    seeker_index := rng_range_int(ref game.role_rng, 0, players.count - 1);
    seeker_index_two: s64 = -1;
    seeker_count := min(STARTING_SEEKERS, max(1, players.count - 1));
    if seeker_count > 1 {
        seeker_index_two = rng_range_int(ref game.role_rng, 0, players.count - 2);
        if seeker_index_two >= seeker_index { seeker_index_two += 1; }
    }
    for i: 0..players.count - 1 {
        player := players[i];
        player.hide_seek_role = .HIDER;
        if i == seeker_index || i == seeker_index_two { player.hide_seek_role = .SEEKER; }
        hide_round_name(player);
        player.role_visual_applied = .NONE;
        player.pending_found_end_time = 0;
        player.fat_stage = 0;
        player.next_fat_time = 0;
        clear_found_freeze(player);
        player.fat_stage = 0;
        player.next_fat_time = 0;
        player.seeker_rig_ready = false;
        player.streamed_seeker_rig_ready = false;
        player.role_reveal_end_time = get_time() + ROLE_REVEAL_SECONDS;
        trigger_role_roll(player);
        player.active_pose = 0;
        player.spawn_placed = true;
        exit_paint_mode(player);
        // The emote menu is an input-blocking modal, so leaving it open across
        // the round start swallows clicks on the ability button underneath.
        player.emotes_open = false;
        // Start every round clean; nothing carries over from the last one.
        remove_all_effects(player.entity);
        // Held until the reel lands - players are moved once they know what they
        // rolled, not while the strip is still spinning. See
        // apply_pending_round_teleport.
        player.pending_round_teleport = true;
    }

    game.phase = .HIDING;
    // Held at the full duration until every reel has landed - see ao_update - so
    // the hiding clock starts when players can actually act, not while they are
    // still watching the roll.
    game.round_start_pending = true;
    game.phase_end_time = get_time() + HIDE_PHASE_SECONDS;
    game.next_forced_whistle_time = 0;
    reset_hide_seek_scores(game);
    refresh_hide_seek_counts(game);
    // A round is live, so matchmaking should fill servers that are still in the
    // lobby before sending anyone here.
    Server.set_matchmaking_priority(1);
    return true;
}

start :: proc(command_player: Player) {
    game := get_hide_seek_game();
    if !#alive(game) { return; }
    game.selected_map = .CITY;
    if !start_hide_seek_round(game, true) {
        Notifier.notify(command_player, "No players are available to start the round.");
    }
} @chat_command @owner_or_editor

startfat :: proc(command_player: Player) {
    game := get_hide_seek_game();
    if !#alive(game) { return; }
    game.selected_map = .ART_HEIST;
    if !start_hide_seek_round(game, true, .FAT) {
        Notifier.notify(command_player, "No players are available to start the round.");
    }
} @chat_command @owner_or_editor

begin_hide_seek_hunt :: proc(game: Hide_Seek_Game) {
    if !#alive(game) || game.phase != .HIDING { return; }
    // Skipping straight to the hunt (/force_start, /skipwait) also ends the
    // start-up hold, or the hunt clock would stay pinned.
    game.round_start_pending = false;
    game.phase = .HUNTING;
    game.phase_end_time = get_time() + HUNT_PHASE_SECONDS;
    game.next_forced_whistle_time = get_time() + FORCED_WHISTLE_SECONDS;
    // Seekers wait in the lobby during hiding and enter the selected map when
    // search begins, whether the timer expires or an editor skips it.
    for player: component_iterator(Player) {
        if game.game_mode == .FAT && player.hide_seek_role == .HIDER {
            player.next_fat_time = get_time() + FAT_GROWTH_SECONDS;
        }
        bell_desc := SFX.default_sfx_desc();
        bell_desc.specific_to_player = player;
        bell_desc.volume = 0.8;
        bell_desc.speed_perturb = 0;
        SFX.play(get_asset(SFX_Asset, "bell-ding_b7781f.wav"), bell_desc);
        if player.hide_seek_role == .SEEKER {
            teleport_player_to_map(game, player);
        }
    }
}

// Testing shortcut: /start followed by /skipwait in one step, so the hunt is
// live immediately instead of after the full hiding phase.
force_start :: proc(command_player: Player) {
    game := get_hide_seek_game();
    if !#alive(game) { return; }
    game.selected_map = .CITY;
    if !start_hide_seek_round(game, true) {
        Notifier.notify(command_player, "No players are available to start the round.");
        return;
    }
    begin_hide_seek_hunt(game);
} @chat_command @owner_or_editor

skipwait :: proc(command_player: Player) {
    game := get_hide_seek_game();
    if !#alive(game) || game.phase != .HIDING {
        Notifier.notify(command_player, "The seeker waiting phase is not active.");
        return;
    }
    begin_hide_seek_hunt(game);
} @chat_command @owner_or_editor

on_hide_seek_player_damaged :: proc(target: Weapon_Target, damage: float, attacker_id: u64, userdata: Object) {
    victim := userdata.(Player);
    target.health = target.max_health;
    game := get_hide_seek_game();
    if !#alive(game) || game.phase != .HUNTING || victim.hide_seek_role != .HIDER { return; }

    attacker: Player;
    for player: component_iterator(Player) {
        if player.entity.id == attacker_id { attacker = player; }
    }
    if !#alive(attacker) || attacker.hide_seek_role != .SEEKER { return; }

    begin_hider_found(game, victim, attacker);
}

publish_found_message :: proc(game: Hide_Seek_Game, seeker: Player, hider: Player) {
    game.found_feed_seeker_name = seeker.get_username();
    game.found_feed_hider_name = hider.get_username();
    seeker_color := seeker.avatar_color;
    hider_color := hider.avatar_color;
    game.found_feed_seeker_color = v4.{1, 1, 1, 1};
    game.found_feed_hider_color = v4.{1, 1, 1, 1};
    if seeker_color != .NONE { game.found_feed_seeker_color = color_replace_get_color(seeker_color); }
    if hider_color != .NONE { game.found_feed_hider_color = color_replace_get_color(hider_color); }
    game.found_feed_start_time = get_time();
    game.found_feed_end_time = get_time() + 4.0;
}

begin_hider_found :: proc(game: Hide_Seek_Game, victim: Player, finder: Player) {
    if victim.hide_seek_role != .HIDER || victim.pending_found_end_time > get_time() { return; }
    victim.pending_found_end_time = get_time() + FOUND_FLICKER_SECONDS;
    victim.found_banner_end_time = victim.pending_found_end_time;
    if !victim.found_movement_frozen {
        victim.add_freeze_reason(FOUND_FREEZE_REASON);
        victim.found_movement_frozen = true;
    }
    publish_found_message(game, finder, victim);
}

clear_found_freeze :: proc(player: Player) {
    if !player.found_movement_frozen { return; }
    player.remove_freeze_reason(FOUND_FREEZE_REASON);
    player.found_movement_frozen = false;
}

POOP_SPINE :: "rainbow_poop_puddle_174cab/rainbow_poop_puddle.spine";
POOP_EXPLOSION_ANIM :: "poop_explosion";
POOP_EFFECT_LIFETIME :: 0.8;
CORPSE_LAYER :: 1;                 // same layer as live hiders
POOP_LAYER :: 1;                   // same layer as the body

// A caught hider leaves their painted body where they fell. It owns a private
// snapshot of the paint rather than sharing the player's live canvas: the
// player becomes a seeker and could repaint next round, and could disconnect
// (which destroys their canvas), either of which would corrupt or dangle a
// shared reference. Cleared at round boundaries by clear_hide_seek_corpses.
CORPSE_IDLE_CLIP :: "pose/idle";     // caught standing still, not emoting
CORPSE_RUN_CLIP  :: "pose/mid_run";  // caught mid-run, not emoting

Hide_Seek_Corpse :: class : Component {
    canvas: Dynamic_Canvas;
    pose_clip: string;   // set at spawn; synced, so every client can pose the body

    ao_end :: method() {
        if canvas != null { canvas.destroy(); }
    }

    // Spawn code only runs on the server and the catching client. Every other
    // client receives the replicated entity WITHOUT the set_animation call, so
    // it showed the skeleton's default pose until sync caught up - the corpse
    // looked different per screen. So each client poses the body itself from
    // the synced clip name.
    //
    // The marker variable identifies our inert state machine. Missing means
    // whatever machine is attached (the rig's own, or a reconciled replacement)
    // could drive track 0 over the clip - swap in a fresh inert one and set the
    // pose. Runs once per machine, on every client, and self-heals if the
    // machine is ever replaced.
    ao_update :: method(dt: float) {
        if pose_clip == "" { return; }
        anim := entity.get_component(Spine_Animator);
        if anim == null { return; }
        sm := anim.state_machine;
        if sm != null && sm.try_get_variable("hide_seek_corpse") != null { return; }
        inert := State_Machine.create();
        inert.create_variable("hide_seek_corpse", .BOOL);
        anim.set_state_machine(inert, true);
        anim.set_animation(pose_clip, false, 0);
    }
}

// The catch splash is brief and self-cleaning. Leaving the animation frozen
// created colorful fragments that looked like active projectiles on the map.
Poop_Explosion :: class : Component {
    lifetime: float;

    ao_update :: method(dt: float) {
        lifetime += dt;
        if lifetime >= POOP_EFFECT_LIFETIME {
            entity.destroy();
        }
    }
}

spawn_hider_death :: proc(victim: Player) {
    pos := victim.entity.world_position;

    // Rainbow poop burst at the point of the catch.
    poop_e := Scene.create_entity();
    poop_e.set_world_position(pos);
    poop := poop_e.add_component(Spine_Animator);
    poop.awaken();
    poop.set_skeleton(get_asset(Spine_Asset, POOP_SPINE));
    poop.layer = POOP_LAYER;
    poop.set_animation(POOP_EXPLOSION_ANIM, false, 0);
    poop_e.add_component(Poop_Explosion);

    desc := SFX.default_sfx_desc();
    desc.entity_to_follow = poop_e.id;
    desc.volume = 0.6;
    desc.speed_perturb = 0.1;
    SFX.play(get_asset(SFX_Asset, "reusable_weapons/sounds/reusable-weapons/geyser_splash_02.wav"), desc);
}

clear_hide_seek_corpses :: proc() {
    corpses: [..]Hide_Seek_Corpse;
    for corpse: component_iterator(Hide_Seek_Corpse) { corpses.append(corpse); }
    for corpse: corpses {
        if #alive(corpse) { corpse.entity.destroy(); }
    }
    splats: [..]Poop_Explosion;
    for splat: component_iterator(Poop_Explosion) { splats.append(splat); }
    for splat: splats {
        if #alive(splat) { splat.entity.destroy(); }
    }
}

convert_hider_to_seeker :: proc(game: Hide_Seek_Game, victim: Player, finder: Player = null) {
    if #alive(finder) { publish_found_message(game, finder, victim); }
    // Mark the spot before the teleport moves the victim off it.
    spawn_hider_death(victim);
    victim.pending_found_end_time = 0;
    victim.fat_stage = 0;
    victim.next_fat_time = 0;
    clear_found_freeze(victim);
    victim.hide_seek_role = .SEEKER;
    hide_round_name(victim);
    exit_paint_mode(victim);
    victim.emotes_open = false;
    victim.active_pose = 0;
    victim.role_visual_applied = .NONE;
    victim.seeker_rig_ready = false;
    victim.streamed_seeker_rig_ready = false;
    // Caught hiders respawn at the map entrance as a seeker rather than
    // carrying on from wherever they were found.
    teleport_player_to_map(game, victim);
    refresh_hide_seek_counts(game);
    if game.hiders_left <= 0 { finish_hide_seek_round(game, .SEEKERS); }
}

capture_original_player_skins :: proc(player: Player) {
    if player.original_player_skins_captured || player.animator == null { return; }
    for skin: player.animator.get_skins() {
        player.original_player_skins.append(skin);
    }
    player.original_player_skins_captured = true;
}

hider_skin_for_stage :: proc(stage: s64) -> string {
    if stage == 1 { return "fat1"; }
    if stage == 2 { return "fat2"; }
    if stage == 3 { return "fat3"; }
    if stage >= 4 { return "fat4"; }
    return MECHA_SKIN;
}

apply_hider_body_skin :: proc(player: Player) {
    if player.animator == null { return; }
    if player.override_ids[0] != 0 {
        player.animator.instance.clear_attachment_sprite_override(player.override_ids[0]);
        player.override_ids[0] = 0;
    }
    player.animator.disable_all_skins();
    player.animator.enable_skin(hider_skin_for_stage(player.fat_stage));
    player.animator.refresh_skins();
    player.mecha_skin_applied = true;
    if player.wear_paint_enabled { wear_paint(player, player.skin_canvas); }
}

grow_fat_hider :: proc(player: Player) {
    if player.hide_seek_role != .HIDER || player.fat_stage >= FAT_MAX_STAGE { return; }
    player.fat_stage += 1;
    apply_hider_body_skin(player);
}

SEEKER_ANIMATION_LAYER :: "seeker_shotgun";
SEEKER_ANIMATION_ACTIVE_VAR :: "seeker_animation_active";

setup_seeker_animation_layer :: proc(player: Player) {
    sm := player.animator.state_machine;
    layer := sm.try_get_layer(SEEKER_ANIMATION_LAYER);
    active := sm.try_get_variable(SEEKER_ANIMATION_ACTIVE_VAR);

    // Skeleton swaps keep the live state machine, so reuse this layer when a
    // former seeker becomes a seeker again. This also migrates layers created
    // before seeker_animation_active existed during editor hot reloads.
    if layer != null {
        if active == null {
            active = sm.create_variable(SEEKER_ANIMATION_ACTIVE_VAR, .BOOL);
            clear_state := layer.try_get_state("__CLEAR_TRACK__");
            if clear_state == null {
                clear_state = layer.create_state("__CLEAR_TRACK__", true);
            }
            idle_state := layer.try_get_state("Idle_mIK");
            layer.set_initial_state(clear_state);
            if idle_state != null {
                layer.create_transition(clear_state, idle_state, false).create_bool_condition(active, true);
            }
            layer.create_global_transition(clear_state, false).create_bool_condition(active, false);
        }
        sm.set_bool(SEEKER_ANIMATION_ACTIVE_VAR, true);
        return;
    }

    moving := sm.create_variable("seeker_moving", .BOOL);
    shoot := sm.create_variable("seeker_shoot", .TRIGGER);
    active = sm.create_variable(SEEKER_ANIMATION_ACTIVE_VAR, .BOOL);
    layer = sm.create_layer(SEEKER_ANIMATION_LAYER, 5);
    clear_state := layer.create_state("__CLEAR_TRACK__", true);
    idle_state := layer.create_state("Idle_mIK", true, 0);
    run_state := layer.create_state("Run_mIK", true, 0);
    shoot_state := layer.create_state("Shoot_Gun_mIK", false, 0.37);
    layer.set_initial_state(clear_state);
    layer.create_transition(clear_state, idle_state, false).create_bool_condition(active, true);
    layer.create_global_transition(clear_state, false).create_bool_condition(active, false);
    layer.create_transition(idle_state, run_state, false).create_bool_condition(moving, true);
    layer.create_transition(run_state, idle_state, false).create_bool_condition(moving, false);
    shoot_transition := layer.create_global_transition(shoot_state, false);
    shoot_transition.create_trigger_condition(shoot);
    shoot_transition.create_bool_condition(active, true);
    layer.create_transition(shoot_state, run_state, true).create_bool_condition(moving, true);
    layer.create_transition(shoot_state, idle_state, true).create_bool_condition(moving, false);
    sm.set_bool(SEEKER_ANIMATION_ACTIVE_VAR, true);
}

deactivate_seeker_animation_layer :: proc(player: Player) {
    if player.animator == null { return; }
    sm := player.animator.state_machine;
    if sm == null { return; }
    layer := sm.try_get_layer(SEEKER_ANIMATION_LAYER);
    if layer == null { return; }

    // Park track 5 synchronously while the seeker rig is still installed. The
    // following skeleton swap can then never ask the Mecha rig for *_mIK clips.
    active := sm.try_get_variable(SEEKER_ANIMATION_ACTIVE_VAR);
    if active != null {
        sm.set_bool(SEEKER_ANIMATION_ACTIVE_VAR, false);
    }
    clear_state := layer.try_get_state("__CLEAR_TRACK__");
    if clear_state == null {
        clear_state = layer.create_state("__CLEAR_TRACK__", true);
    }
    layer.set_initial_state(clear_state);
    layer.reset_to_initial_state();
}

apply_seeker_visuals :: proc(player: Player) {
    if player.animator == null { return; }
    player.remove_name_offset_reason(HIDER_NAME_OFFSET_REASON);
    if player.equipped_weapon_type != .NONE {
        weapon_unequip(player, player.equipped_weapon_type);
        player.equipped_weapon_type = .NONE;
    }
    if player.override_ids[0] != 0 {
        player.animator.instance.clear_attachment_sprite_override(player.override_ids[0]);
        player.override_ids[0] = 0;
    }
    if player.seeker_shotgun_override_id != 0 {
        player.animator.instance.clear_attachment_sprite(player.seeker_shotgun_override_id);
        player.seeker_shotgun_override_id = 0;
    }
    // Drop any emote before the swap. An emote parks the locomotion tracks on
    // __CLEAR_TRACK__ and only releases them when mecha_pose returns to 0 - but
    // ao_update only pushes the pose for non-seekers, so once the role flips
    // nothing would ever clear it and the new rig stays frozen mid-pose.
    release_mecha_emote(player);
    player.animator.set_skeleton(get_asset(Spine_Asset, SEEKER_RIG));
    player.animator.scale = v2.{0.7, 0.7};
    player.animator.layer = SEEKER_ANIMATOR_LAYER;
    player.animator.disable_all_skins();
    player.animator.enable_skin("base/crewchsia");
    for skin: player.original_player_skins {
        if skin != "base/crewchsia" && skin != "weapons/balloon_sword" && skin != "weapons/gun" && skin != "weapons/hand_gun" && skin != "weapons/water_pistol" {
            player.animator.enable_skin(skin);
        }
    }
    player.animator.refresh_skins();
    setup_seeker_animation_layer(player);
    shotgun_desc := Attachment_Desc.default();
    shotgun_desc.draw_mode = .BEHIND;
    shotgun_desc.scale = v2.{1.2, 1.2};
    shotgun_desc.offset = v2.{0.18, 0};
    player.seeker_shotgun_override_id = player.animator.instance.add_attachment_sprite(
        SEEKER_WEAPON_SLOT,
        get_asset(Texture_Asset, SEEKER_SHOTGUN_TEXTURE),
        shotgun_desc
    );
    player.emotes_open = false;
    // Force the hider path to validate its locomotion layer after the next rig
    // swap. setup_mecha_locomotion is idempotent when that layer survives.
    player.locomotion_ready = false;
    player.seeker_rig_ready = true;
    player.streamed_seeker_rig_ready = true;
    player.role_visual_applied = .SEEKER;
}

apply_hider_visuals :: proc(player: Player) {
    if player.animator == null { return; }
    deactivate_seeker_animation_layer(player);
    player.remove_name_offset_reason(HIDER_NAME_OFFSET_REASON);
    player.add_name_offset_reason(HIDER_NAME_OFFSET_REASON, HIDER_NAME_OFFSET);
    if player.equipped_weapon_type != .NONE {
        weapon_unequip(player, player.equipped_weapon_type);
        player.equipped_weapon_type = .NONE;
    }
    if player.seeker_shotgun_override_id != 0 {
        player.animator.instance.clear_attachment_sprite(player.seeker_shotgun_override_id);
        player.seeker_shotgun_override_id = 0;
    }
    player.animator.set_skeleton(get_asset(Spine_Asset, MECHA_RIG_PATH));
    player.animator.scale = v2.{MECHA_RENDER_SCALE, MECHA_RENDER_SCALE};
    player.animator.layer = HIDER_ANIMATOR_LAYER;
    apply_hider_body_skin(player);
    // The state machine can survive a skeleton swap. Clear the latch so
    // ensure_mecha_rig validates or rebuilds the Mecha layers either way.
    player.locomotion_ready = false;
    player.seeker_rig_ready = false;
    player.streamed_seeker_rig_ready = false;
    player.role_visual_applied = .HIDER;
}

update_hide_seek_player :: proc(player: Player) {
    player.remove_name_offset_reason(HIDER_NAME_OFFSET_REASON);
    if player.hide_seek_role != .SEEKER {
        player.add_name_offset_reason(HIDER_NAME_OFFSET_REASON, HIDER_NAME_OFFSET);
    }
    if player.weapon_target != null {
        player.weapon_target.health = player.weapon_target.max_health;
    }
    if player.hide_seek_role == .SEEKER && (!player.streamed_seeker_rig_ready || player.role_visual_applied != .SEEKER || player.equipped_weapon_type != .NONE) {
        exit_paint_mode(player);
        apply_seeker_visuals(player);
    } else if (player.hide_seek_role == .HIDER || player.hide_seek_role == .LOBBY) && player.role_visual_applied != .HIDER {
        // Lobby waiters wear the same rig as hiders - it is the lobby look, and
        // it keeps their paint job on while they wait out the round.
        apply_hider_visuals(player);
    }
}

hide_seek_phase_title :: proc(game: Hide_Seek_Game, player: Player) -> string {
    switch game.phase {
        case .WAITING_FOR_PLAYERS:    return "WAITING FOR PLAYERS";
        case .STARTING_MAP_SELECTION: return "GAME STARTING";
        case .MAP_SELECTION:          return "VOTE FOR A MAP";
        case .STARTING_GAME:          return "STARTING IN";
        case .HIDING: {
            if player.hide_seek_role == .LOBBY { return "NEXT ROUND"; }
            if player.hide_seek_role == .SEEKER { return "WAIT"; }
            return "HIDE";
        }
        case .HUNTING: {
            if player.hide_seek_role == .LOBBY { return "NEXT ROUND"; }
            if player.hide_seek_role == .SEEKER { return "FIND HIDERS"; }
            return "STAY HIDDEN";
        }
        case .REVEAL: {
            if game.winner == .SEEKERS { return "SEEKERS WIN"; }
            return "HIDERS WIN";
        }
        default: return "";
    }
}

draw_found_feed :: proc(player: Player) {
    game := get_hide_seek_game();
    if !#alive(game) || get_time() >= game.found_feed_end_time { return; }
    // Same reason as the leaderboard and whistle countdown: not their round.
    if player.hide_seek_role == .LOBBY { return; }
    if game.found_feed_seeker_name == "" || game.found_feed_hider_name == "" { return; }

    elapsed := max(0.0, get_time() - game.found_feed_start_time);
    remaining := max(0.0, game.found_feed_end_time - get_time());
    fade_in := clamp(elapsed / 0.4, 0, 1);
    fade_out := clamp(remaining, 0, 1);
    alpha := min(fade_in, fade_out);
    rise_t := Ease.out_cubic(fade_in);
    y_offset := lerp(70.0, 150.0, rise_t);

    begin_desc := UIK.window(UI.get_safe_screen_rect());
    begin_desc.layer = 130;
    UIK.begin(begin_desc);
    defer UIK.end();

    message_text := `{game.found_feed_seeker_name} found {game.found_feed_hider_name}`;
    message_scale := clamp(24.0 / max(24.0, message_text.count.(float)), 0.45, 0.85);
    message := UIK.layout_column();
    message.width = UIK.pixels(680);
    message.height = UIK.pixels(64);
    message.cross_align = .CENTER;
    message.main_align = .CENTER;
    message.clip_children = true;
    message.padding = v4.{8, 14, 8, 14};
    UIK.overlay_begin(.BOTTOM_CENTER, message, v2.{0, y_offset});
    defer UIK.overlay_end();

    message_desc := UIK.text_title();
    message_desc.set_size_mult(message_scale);
    message_desc.set_halign(.CENTER);
    message_desc.set_color(v4.{1, 1, 1, alpha});
    message_desc.set_outline(true, 4.0, v4.{0, 0, 0, alpha});
    UIK.text(message_desc, message_text);
}

draw_hide_time_banner :: proc(player: Player, game: Hide_Seek_Game) {
    if game.phase != .HIDING || player.hide_seek_role != .HIDER { return; }

    elapsed := HIDE_PHASE_SECONDS - max(0.0, game.phase_end_time - get_time());
    if elapsed < 0 || elapsed >= 4.0 { return; }
    alpha := clamp(4.0 - elapsed, 0, 1);

    begin_desc := UIK.window(UI.get_safe_screen_rect());
    begin_desc.layer = 105;
    UIK.begin(begin_desc);
    defer UIK.end();

    banner := UIK.panel_modal(.TRANSP_BLACK, UIK.pixels(520), UIK.pixels(88), 0, v4.{8, 16, 8, 16});
    banner.background_sprite_override = get_asset(Texture_Asset, "gradient-text-bg.png");
    banner.tint = v4.{1, 1, 1, 1};
    banner.cross_align = .CENTER;
    banner.main_align = .CENTER;
    banner.opacity = alpha;
    UIK.overlay_begin(.TOP_CENTER, banner, v2.{0, -176});
    defer UIK.overlay_end();

    text_desc := UIK.text_title();
    text_desc.set_size_mult(1.55);
    text_desc.set_halign(.CENTER);
    text_desc.set_color(v4.{1, 1, 1, alpha});
    UIK.text(text_desc, "HIDE TIME");
}

// Seekers spend the whole hiding phase with nothing to do, so this stays up for
// the duration rather than flashing like the hider banner. The countdown in the
// HUD already says how long, so the banner only has to say what is happening.
draw_seeker_wait_banner :: proc(player: Player, game: Hide_Seek_Game) {
    if game.phase != .HIDING || player.hide_seek_role != .SEEKER { return; }

    remaining := max(0.0, game.phase_end_time - get_time());
    elapsed := HIDE_PHASE_SECONDS - remaining;
    alpha := min(clamp(elapsed / 0.4, 0, 1), clamp(remaining / 0.5, 0, 1));
    if alpha <= 0 { return; }

    begin_desc := UIK.window(UI.get_safe_screen_rect());
    begin_desc.layer = 105;
    UIK.begin(begin_desc);
    defer UIK.end();

    banner := UIK.panel_modal(.TRANSP_BLACK, UIK.fit(), UIK.pixels(84), 16, v4.{6, 26, 6, 26});
    banner.axis = .HORIZONTAL;
    banner.cross_align = .CENTER;
    banner.main_align = .CENTER;
    banner.opacity = alpha;
    UIK.overlay_begin(.BOTTOM_CENTER, banner, v2.{0, 44});
    defer UIK.overlay_end();

    draw_seeker_wait_icon(alpha);
    text_desc := UIK.text_title();
    text_desc.set_size_mult(1.4);
    text_desc.set_halign(.CENTER);
    text_desc.set_color(v4.{1, 1, 1, alpha});
    UIK.text(text_desc, "HIDERS ARE HIDING");
    draw_seeker_wait_icon(alpha);
}

draw_seeker_wait_icon :: proc(alpha: float) {
    icon_box := UIK.layout_column();
    icon_box.width = UIK.pixels(60);
    icon_box.height = UIK.pixels(60);
    UIK.panel_begin(icon_box);
    UIK.image_fitted(get_asset(Texture_Asset, "stripe_triangle.png"), UIK.image_desc(.CONTAIN), v4.{1, 1, 1, alpha});
    UIK.panel_end();
}

// For players who joined after the round started. Sits in the same top slot the
// whistle countdown uses, which those players never see.
draw_lobby_waiter_banner :: proc(player: Player, game: Hide_Seek_Game) {
    if player.hide_seek_role != .LOBBY { return; }
    if game.phase != .HIDING && game.phase != .HUNTING { return; }

    begin_desc := UIK.window(UI.get_safe_screen_rect());
    begin_desc.layer = 104;
    UIK.begin(begin_desc);
    defer UIK.end();

    banner := UIK.panel_modal(.TRANSP_BLACK, UIK.fit(), UIK.pixels(72), 14, v4.{6, 24, 6, 24});
    banner.axis = .HORIZONTAL;
    banner.cross_align = .CENTER;
    banner.main_align = .CENTER;
    UIK.overlay_begin(.TOP_CENTER, banner, v2.{0, -250});
    defer UIK.overlay_end();

    draw_waiter_warning_icon();
    text_desc := UIK.text_title();
    text_desc.set_size_mult(0.9);
    text_desc.set_halign(.CENTER);
    text_desc.set_color(v4.{1, 1, 1, 1});
    text_desc.set_outline(true, 3.0, v4.{0, 0, 0, 1});
    UIK.text(text_desc, "ROUND IN PROGRESS - YOU PLAY NEXT");
    draw_waiter_warning_icon();
}

draw_waiter_warning_icon :: proc() {
    icon_box := UIK.layout_column();
    icon_box.width = UIK.pixels(48);
    icon_box.height = UIK.pixels(48);
    UIK.panel_begin(icon_box);
    UIK.image_fitted(get_asset(Texture_Asset, "stripe_triangle.png"), UIK.image_desc(.CONTAIN));
    UIK.panel_end();
}

draw_found_banner :: proc(player: Player) {
    remaining := player.found_banner_end_time - get_time();
    if remaining <= 0 { return; }
    alpha := clamp(remaining, 0, 1);

    begin_desc := UIK.window(UI.get_safe_screen_rect());
    begin_desc.layer = 106;
    UIK.begin(begin_desc);
    defer UIK.end();

    banner := UIK.panel_modal(.TRANSP_BLACK, UIK.pixels(620), UIK.pixels(96), 0, v4.{8, 16, 8, 16});
    banner.background_sprite_override = get_asset(Texture_Asset, "gradient-text-bg.png");
    banner.tint = v4.{1, 1, 1, 1};
    banner.cross_align = .CENTER;
    banner.main_align = .CENTER;
    banner.opacity = alpha;
    UIK.overlay_begin(.TOP_CENTER, banner, v2.{0, -176});
    defer UIK.overlay_end();

    text_desc := UIK.text_title();
    text_desc.set_size_mult(1.45);
    text_desc.set_halign(.CENTER);
    text_desc.set_color(v4.{1, 1, 1, alpha});
    UIK.text(text_desc, "YOU'VE BEEN FOUND!");
}

draw_search_start_banner :: proc(game: Hide_Seek_Game) {
    if game.phase != .HUNTING { return; }
    elapsed := HUNT_PHASE_SECONDS - max(0.0, game.phase_end_time - get_time());
    if elapsed < 0 || elapsed >= 3.0 { return; }
    fade_in := clamp(elapsed / 0.4, 0, 1);
    fade_out := clamp(3.0 - elapsed, 0, 1);
    alpha := min(fade_in, fade_out);

    begin_desc := UIK.window(UI.get_safe_screen_rect());
    begin_desc.layer = 105;
    UIK.begin(begin_desc);
    defer UIK.end();

    banner := UIK.panel_modal(.TRANSP_BLACK, UIK.pixels(560), UIK.pixels(92), 0, v4.{8, 16, 8, 16});
    banner.background_sprite_override = get_asset(Texture_Asset, "gradient-text-bg.png");
    banner.tint = v4.{1, 1, 1, 1};
    banner.cross_align = .CENTER;
    banner.main_align = .CENTER;
    banner.opacity = alpha;
    UIK.overlay_begin(.CENTER, banner, v2.{0, 0});
    defer UIK.overlay_end();

    text_desc := UIK.text_title();
    text_desc.set_size_mult(1.5);
    text_desc.set_halign(.CENTER);
    text_desc.set_color(v4.{1, 1, 1, alpha});
    UIK.text(text_desc, "SEARCH START!");
}

HOURGLASS_SIZE :: 80.0;
// Space reserved under the hourglass so it never crowds the countdown number.
HOURGLASS_GAP :: 18.0;
// panel_y (0) + panel top padding (2) + row cross centering (3.6) + half the
// icon. Keep in step with the scoreboard row / timer_group heights below.
HOURGLASS_TOP_OFFSET :: 5.6 + HOURGLASS_SIZE * 0.5;
HOURGLASS_FLIP_DURATION :: 0.5;
VOTE_HOURGLASS_SIZE :: 64.0;
VOTE_HOURGLASS_GAP :: 8.0;

hourglass_flip_angle :: proc(game: Hide_Seek_Game, time: float) -> float {
    remaining := max(0.0, game.phase_end_time - time);
    whole := remaining.(s64);
    tick_age := 1.0 - (remaining - whole.(float));
    t := Ease.in_out_cubic(clamp(tick_age / HOURGLASS_FLIP_DURATION, 0, 1));
    return (whole % 2).(float) * 180.0 + t * 180.0;
}

// top_offset is measured down from the top of the safe area, so a caller places
// it by adding up the panel offset, padding and half the icon.
draw_hourglass_flip :: proc(game: Hide_Seek_Game, top_offset: float = HOURGLASS_TOP_OFFSET, size: float = HOURGLASS_SIZE) {
    hourglass := get_asset(Texture_Asset, "hourglass-image.png");
    if hourglass == null { return; }

    screen := UI.get_safe_screen_rect();
    center := v2.{screen.center().x, screen.max.y - top_offset};
    rect := Rect{center, center}.grow(size * 0.5).fit_aspect(hourglass.get_aspect());

    matrix := Matrix4.rotate_about_point(rect.center(), hourglass_flip_angle(game, get_time()));
    previous_matrix := Matrix4.rotate_about_point(rect.center(), hourglass_flip_angle(game, get_time() - get_fixed_delta_time()));

    UI.push_screen_draw_context();
    UI.push_layer(100);
    UI.push_matrix(matrix);
    UI.quad_interpolated(rect, rect, previous_matrix, hourglass);
    UI.pop_matrix();
    UI.pop_layer();
    UI.pop_draw_context();
}

// m:ss. Seconds are always two digits so the number does not change width as it
// counts down, which would make it jitter under the punch scale.
format_countdown :: proc(total_seconds: s64) -> string {
    minutes := total_seconds / 60;
    seconds := total_seconds % 60;
    if seconds < 10 { return `{minutes}:0{seconds}`; }
    return `{minutes}:{seconds}`;
}

draw_uik_countdown :: proc(game: Hide_Seek_Game, ui_scale: float = 1.0, show_clock: bool = true) {
    remaining := max(0.0, game.phase_end_time - get_time());
    total_seconds := remaining.(s64);
    fraction := remaining - total_seconds.(float);
    tick_age := 1.0 - fraction;
    punch_t := clamp(tick_age / 0.28, 0, 1);
    scale := lerp(1.18, 1.0, punch_t);
    timer_color := HUD_YELLOW;
    if total_seconds > 0 && total_seconds <= 10 && total_seconds % 2 == 0 {
        timer_color = v4.{1.0, 0.16, 0.16, 1};
    }

    timer_row := UIK.layout_row(UIK.pixels(220 * ui_scale), UIK.pixels(64 * ui_scale), 10 * ui_scale);
    timer_row.cross_align = .CENTER;
    timer_row.main_align = .CENTER;
    UIK.panel_begin(timer_row);
    if show_clock {
        clock_box := UIK.layout_column();
        clock_box.width = UIK.pixels(44 * ui_scale);
        clock_box.height = UIK.pixels(48 * ui_scale);
        UIK.panel_begin(clock_box);
        UIK.image_fitted(get_asset(Texture_Asset, "$AO/ui/kit/Icons/clock/clock_icon.png"), UIK.image_desc(.CONTAIN));
        UIK.panel_end();
    }
    number_box := UIK.layout_column();
    number_width := 140.0;
    if !show_clock { number_width = 220.0; }
    number_box.width = UIK.pixels(number_width * ui_scale);
    number_box.height = UIK.pixels(62 * ui_scale);
    number_box.cross_align = .CENTER;
    number_box.main_align = .CENTER;
    UIK.panel_begin(number_box);
    timer_desc := UIK.text_title();
    timer_desc.set_size_mult(1.25 * scale * ui_scale);
    timer_desc.set_halign(.CENTER);
    timer_desc.set_color(timer_color);
    UIK.text(timer_desc, format_countdown(total_seconds));
    UIK.panel_end();
    UIK.panel_end();
}

draw_victory_screen :: proc(player: Player, game: Hide_Seek_Game, dt: float) {
    remaining := max(0.0, game.phase_end_time - get_time());
    elapsed := VICTORY_SCREEN_SECONDS - remaining;
    winner_title := "HIDERS WIN";
    player_won := player.hide_seek_role == .HIDER;
    if game.winner == .SEEKERS {
        winner_title = "SEEKERS WIN";
        player_won = player.hide_seek_role == .SEEKER;
    }
    result_color := v4.{1.0, 0.18, 0.18, 1};
    if player_won { result_color = v4.{0.25, 1.0, 0.45, 1}; }

    if player_won {
        if player.victory_confetti == null {
            player.victory_confetti = Spine_Instance.create();
            player.victory_confetti.set_skeleton(get_asset(Spine_Asset, "ConfettiSpine/004RAND_confetti.spine"));
            player.victory_confetti.set_animation("Confetti_Explosion", false, 0);
        }
        player.victory_confetti.update(dt * 0.4);
        screen := UI.get_safe_screen_rect();
        confetti_scale := max(screen.width() / 5.76, screen.height() / 4.53) * 1.35;
        rain_t := Ease.in_out_cubic(clamp(elapsed / 3.0, 0, 1));
        rain_y := lerp(screen.height() * 0.38, screen.height() * -0.18, rain_t);
        UI.push_screen_draw_context();
        UI.push_layer(151);
        UI.spine(screen.center() + v2.{0, rain_y}, player.victory_confetti, v2.{confetti_scale, confetti_scale}, 0);
        UI.pop_layer();
        UI.pop_draw_context();
    } else if player.victory_confetti != null {
        player.victory_confetti.destroy();
        player.victory_confetti = null;
    }

    begin_desc := UIK.modal(UI.get_safe_screen_rect(), 150, v4.{0.02, 0.02, 0.03, 0.86});
    UIK.begin(begin_desc);
    defer UIK.end();

    content := UIK.layout_column();
    content.width = UIK.pixels(760);
    content.height = UIK.fit();
    content.gap = 18;
    content.cross_align = .CENTER;
    UIK.overlay_begin(.CENTER, content, v2.{0, 30});
    defer UIK.overlay_end();

    title_desc := UIK.text_title();
    title_desc.set_size_mult(2.5);
    title_desc.set_halign(.CENTER);
    title_desc.set_color(result_color);
    UIK.text(title_desc, winner_title);

    draw_uik_countdown(game);

    return_desc := UIK.text_title();
    return_desc.set_size_mult(1.15);
    return_desc.set_halign(.CENTER);
    UIK.text(return_desc, `Returning to lobby in {remaining.(s64)}s`);

    result_desc := UIK.text_body();
    result_desc.set_size_mult(1.1);
    result_desc.set_halign(.CENTER);
    result_desc.set_color(result_color);
    if player_won {
        UIK.text(result_desc, "YOUR TEAM WON");
    } else {
        UIK.text(result_desc, "YOUR TEAM LOST");
    }
}

draw_hide_seek_ui :: proc(player: Player, dt: float) {
    game := get_hide_seek_game();
    if !#alive(game) { return; }
    // The vote screen carries its own title and timer.
    if game.phase == .MAP_SELECTION { return; }
    if game.phase == .REVEAL {
        draw_victory_screen(player, game, dt);
        return;
    }
    if player.victory_confetti != null {
        player.victory_confetti.destroy();
        player.victory_confetti = null;
    }

    active_round := game.phase == .HIDING || game.phase == .HUNTING;
    draw_hide_time_banner(player, game);
    draw_seeker_wait_banner(player, game);
    draw_whistle_warning_banner(player, game);
    draw_lobby_waiter_banner(player, game);
    draw_search_start_banner(game);
    draw_found_banner(player);
    if active_round { draw_hourglass_flip(game); }
    // panel_y (20) + panel top padding (14) + half the icon.
    if game.phase == .STARTING_MAP_SELECTION {
        draw_hourglass_flip(game, 34 + VOTE_HOURGLASS_SIZE * 0.5, VOTE_HOURGLASS_SIZE);
    }

    UIK.begin(UIK.window(UI.get_safe_screen_rect()));
    defer UIK.end();
    panel_width := 680.0;
    if game.phase == .STARTING_MAP_SELECTION { panel_width = 364; }
    panel_radius := 8.0;
    panel_padding := v4.{14, 22, 14, 22};
    panel_y := -20.0;
    if active_round {
        panel_width = 576;
        panel_radius = 7.2;
        panel_padding = v4.{2, 19.8, 12.6, 19.8};
        panel_y = 0;
    }
    panel := UIK.panel_modal(.TRANSP_BLACK, UIK.pixels(panel_width), UIK.fit(), panel_radius, panel_padding);
    // Backgroundless during the round and the vote countdown; the text carries
    // its own outline instead.
    if active_round || game.phase == .STARTING_MAP_SELECTION { panel.show_background = false; }
    panel.cross_align = .CENTER;
    UIK.overlay_begin(.TOP_CENTER, panel, v2.{0, panel_y});
    defer UIK.overlay_end();

    title := hide_seek_phase_title(game, player);

    remaining := 0.0;
    if game.phase != .WAITING_FOR_PLAYERS { remaining = max(0.0, game.phase_end_time - get_time()); }
    total_seconds := remaining.(s64);
    if game.phase == .WAITING_FOR_PLAYERS {
        connected_players := 0;
        for connected_player: component_iterator(Player) { connected_players += 1; }
        waiting_title_desc := UIK.text_title();
        waiting_title_desc.set_halign(.CENTER);
        UIK.text(waiting_title_desc, title);
        waiting_count_desc := UIK.text_body();
        waiting_count_desc.set_halign(.CENTER);
        UIK.text(waiting_count_desc, `{connected_players}/{game.min_players} Players`);
    } else if game.phase == .STARTING_MAP_SELECTION {
        // Space for the flipping hourglass, which is drawn immediate-mode above
        // (UIK cannot rotate an image). Sits at the top of the panel where its
        // position is a plain sum of the panel offset and padding.
        UIK.spacer(UIK.pixels(1), UIK.pixels(VOTE_HOURGLASS_SIZE + VOTE_HOURGLASS_GAP));
        vote_start_desc := UIK.text_title();
        vote_start_desc.set_size_mult(0.8);
        vote_start_desc.set_halign(.CENTER);
        vote_start_desc.set_outline(true, 3.0, v4.{0, 0, 0, 1});
        UIK.text(vote_start_desc, "GAME STARTING IN");
        draw_uik_countdown(game, 0.7, false);
    } else if game.phase == .STARTING_GAME {
        starting_desc := UIK.text_title();
        starting_desc.set_halign(.CENTER);
        UIK.text(starting_desc, title);
        draw_uik_countdown(game);
    } else if game.phase == .REVEAL {
        UIK.text(UIK.text_title(), title);
        draw_uik_countdown(game);
        UIK.text(UIK.text_body(), `{map_display_name(game.selected_map)}`);
    } else if active_round {
        scoreboard := UIK.layout_row(UIK.flex(1), UIK.pixels(90 + HOURGLASS_SIZE + HOURGLASS_GAP), 16.2);
        scoreboard.cross_align = .CENTER;
        scoreboard.main_align = .SPACE_BETWEEN;
        UIK.panel_begin(scoreboard);

        seeker_group := UIK.layout_column();
        seeker_group.width = UIK.pixels(135);
        seeker_group.height = UIK.pixels(75.6);
        seeker_group.gap = 1.8;
        seeker_group.cross_align = .CENTER;
        UIK.panel_begin(seeker_group);
        seeker_row := UIK.layout_row(UIK.fit(), UIK.pixels(50.4), 7.2);
        seeker_row.cross_align = .CENTER;
        UIK.panel_begin(seeker_row);
        seeker_icon_box := UIK.layout_column();
        seeker_icon_box.width = UIK.pixels(43.2);
        seeker_icon_box.height = UIK.pixels(46.8);
        UIK.panel_begin(seeker_icon_box);
        UIK.image_fitted(get_asset(Texture_Asset, "magnifying_glass_icon.png"), UIK.image_desc(.CONTAIN));
        UIK.panel_end();
        seeker_count_desc := UIK.text_title();
        seeker_count_desc.set_size_mult(1.215);
        seeker_count_desc.set_color(v4.{1, 0.18, 0.18, 1});
        UIK.text(seeker_count_desc, `{game.seekers}`);
        UIK.panel_end();
        seeker_label_desc := UIK.text_title();
        seeker_label_desc.set_size_mult(0.6);
        seeker_label_desc.set_halign(.CENTER);
        seeker_label_desc.set_outline(true, 3.0, v4.{0, 0, 0, 1});
        UIK.text(seeker_label_desc, "SEEKERS");
        UIK.panel_end();

        timer_group := UIK.layout_column();
        timer_group.width = UIK.pixels(225);
        timer_group.height = UIK.pixels(82.8 + HOURGLASS_SIZE + HOURGLASS_GAP);
        timer_group.cross_align = .CENTER;
        UIK.panel_begin(timer_group);
        UIK.spacer(UIK.pixels(1), UIK.pixels(HOURGLASS_SIZE + HOURGLASS_GAP));
        draw_uik_countdown(game, 0.9, false);
        phase_desc := UIK.text_title();
        phase_desc.set_size_mult(0.52);
        phase_desc.set_halign(.CENTER);
        phase_desc.set_outline(true, 3.0, v4.{0, 0, 0, 1});
        timer_caption := title;
        if game.phase == .HIDING { timer_caption = "Until Search Starts"; }
        UIK.text(phase_desc, timer_caption);

        UIK.panel_end();

        hider_group := UIK.layout_column();
        hider_group.width = UIK.pixels(135);
        hider_group.height = UIK.pixels(75.6);
        hider_group.gap = 1.8;
        hider_group.cross_align = .CENTER;
        UIK.panel_begin(hider_group);
        hider_row := UIK.layout_row(UIK.fit(), UIK.pixels(50.4), 7.2);
        hider_row.cross_align = .CENTER;
        UIK.panel_begin(hider_row);
        hider_icon_box := UIK.layout_column();
        hider_icon_box.width = UIK.pixels(43.2);
        hider_icon_box.height = UIK.pixels(46.8);
        UIK.panel_begin(hider_icon_box);
        UIK.image_fitted(get_asset(Texture_Asset, "hider-icon.png"), UIK.image_desc(.CONTAIN));
        UIK.panel_end();
        hider_count_desc := UIK.text_title();
        hider_count_desc.set_size_mult(1.215);
        hider_count_desc.set_color(v4.{0.25, 1, 0.45, 1});
        UIK.text(hider_count_desc, `{game.hiders_left}`);
        UIK.panel_end();
        hider_label_desc := UIK.text_title();
        hider_label_desc.set_size_mult(0.6);
        hider_label_desc.set_halign(.CENTER);
        hider_label_desc.set_outline(true, 3.0, v4.{0, 0, 0, 1});
        UIK.text(hider_label_desc, "HIDERS");
        UIK.panel_end();

        UIK.panel_end();
    } else {
        UIK.text(UIK.text_title(), title);
    }
}

// Crowns for the podium, null past third so the row falls back to "#4".
rank_crown_texture :: proc(rank_index: s64) -> Texture_Asset {
    if rank_index == 0 { return get_asset(Texture_Asset, "crown_gold.png"); }
    if rank_index == 1 { return get_asset(Texture_Asset, "crown_silver.png"); }
    if rank_index == 2 { return get_asset(Texture_Asset, "crown_bronze.png"); }
    return null;
}

draw_hide_seek_leaderboard :: proc(player: Player) {
    game := get_hide_seek_game();
    if !#alive(game) { return; }
    if game.phase != .HIDING && game.phase != .HUNTING && game.phase != .REVEAL { return; }
    // Seekers are parked in the lobby for the whole hiding phase with no way to
    // act on standings, so the board only clutters their wait screen.
    if game.phase == .HIDING && player.hide_seek_role == .SEEKER { return; }
    // Lobby waiters are not in this round at all, so they neither see the board
    // nor appear on it.
    if player.hide_seek_role == .LOBBY { return; }

    players: [..]Player;
    for p: component_iterator(Player) {
        if p.hide_seek_role == .LOBBY { continue; }
        players.append(p);
    }
    if players.count == 0 { return; }

    // Insertion sort, highest published score first.
    if players.count > 1 {
        for i: 1..players.count - 1 {
            j := i;
            while j > 0 && players[j].published_score > players[j - 1].published_score {
                swap := players[j];
                players[j] = players[j - 1];
                players[j - 1] = swap;
                j -= 1;
            }
        }
    }

    begin_desc := UIK.window(UI.get_safe_screen_rect());
    begin_desc.layer = 100;
    UIK.begin(begin_desc);
    defer UIK.end();

    panel := UIK.panel_modal(.TRANSP_BLACK, UIK.pixels(350), UIK.fit(), 2.5, v4.{8.75, 11.25, 8.75, 11.25});
    UIK.overlay_begin(.TOP_LEFT, panel, v2.{12.5, -12.5});
    defer UIK.overlay_end();

    header := UIK.layout_row(UIK.flex(1), UIK.pixels(60), 6.25);
    header.cross_align = .CENTER;
    header.main_align = .SPACE_BETWEEN;
    UIK.panel_begin(header);
    title_desc := UIK.text_title();
    title_desc.set_size_mult(0.75);
    UIK.text(title_desc, "Ranking");

    // Label and count are separate fixed lines. As one string the countdown
    // wraps once it hits two digits, which resizes the panel every tick.
    remaining := max(0.0, game.next_publish_time - get_time());
    next_box := UIK.layout_column();
    next_box.width = UIK.pixels(131.25);
    next_box.height = UIK.pixels(60);
    next_box.gap = 0;
    next_box.cross_align = .CENTER;
    next_box.main_align = .CENTER;
    next_box.clip_children = true;
    UIK.panel_begin(next_box);
    next_label := UIK.text_body();
    next_label.set_size_mult(0.625);
    next_label.set_halign(.CENTER);
    next_label.set_color(HUD_YELLOW);
    UIK.text(next_label, "Next update");
    next_value := UIK.text_body();
    next_value.set_size_mult(0.625);
    next_value.set_halign(.CENTER);
    next_value.set_color(HUD_YELLOW);
    UIK.text(next_value, `{remaining.(s64)}`);
    UIK.panel_end();
    UIK.panel_end();

    shown := players.count;
    if shown > LEADERBOARD_MAX_ROWS { shown = LEADERBOARD_MAX_ROWS; }
    for i: 0..shown - 1 {
        entry := players[i];
        row := UIK.layout_row(UIK.flex(1), UIK.pixels(32.5), 6.25);
        row.cross_align = .CENTER;
        UIK.panel_begin(row);

        rank_box := UIK.layout_column();
        rank_box.width = UIK.pixels(56.25);
        rank_box.cross_align = .CENTER;
        rank_box.main_align = .CENTER;
        UIK.panel_begin(rank_box);
        crown := rank_crown_texture(i);
        if crown != null {
            // Top three wear a crown instead of a number - the position reads at
            // a glance and the row keeps the same height either way.
            UIK.image_fitted(crown, UIK.image_desc(.CONTAIN));
        } else {
            rank_desc := UIK.text_body();
            rank_desc.set_size_mult(0.625);
            rank_desc.set_halign(.CENTER);
            UIK.text(rank_desc, `#{i + 1}`);
        }
        UIK.panel_end();

        name_box := UIK.layout_column();
        name_box.width = UIK.flex(1);
        name_box.cross_align = .CENTER;
        name_box.main_align = .CENTER;
        name_box.clip_children = true;
        UIK.panel_begin(name_box);
        name_desc := UIK.text_body();
        name_desc.set_size_mult(0.625);
        name_desc.set_halign(.CENTER);
        color := entry.avatar_color;
        if color != .NONE { name_desc.set_color(color_replace_get_color(color)); }
        UIK.text(name_desc, entry.get_username());
        UIK.panel_end();

        score_box := UIK.layout_column();
        score_box.width = UIK.pixels(68.75);
        score_box.cross_align = .CENTER;
        score_box.main_align = .CENTER;
        UIK.panel_begin(score_box);
        score_desc := UIK.text_body();
        score_desc.set_size_mult(0.625);
        score_desc.set_halign(.RIGHT);
        UIK.text(score_desc, `{entry.published_score}`);
        UIK.panel_end();

        UIK.panel_end();
    }
}

draw_map_vote_card :: proc(player: Player, game: Hide_Seek_Game, index: s64, dt: float) {
    map := index.(Map_Kind);

    card := UIK.layout_column();
    card.width = UIK.pixels(MAP_CARD_WIDTH);
    card.height = UIK.fit();
    card.gap = 8;
    card.padding = v4.{12, 12, 12, 12};
    card.background = .MODAL_TRANSP_BLACK;
    card.cross_align = .CENTER;
    result := UIK.panel_begin_interactive(`map_vote_{index}`, card);
    defer UIK.panel_end();

    // Hold to commit a vote. Releasing early discards the partial hold, so a
    // stray click cannot lock someone into a map.
    if result.pressed {
        if player.map_vote_hold_index != index {
            player.map_vote_hold_index = index;
            player.map_vote_hold_t = 0;
        }
        player.map_vote_hold_t += dt;
        if player.map_vote_hold_t >= MAP_VOTE_HOLD_SECONDS { player.map_vote = index; }
    } else if player.map_vote_hold_index == index {
        player.map_vote_hold_index = -1;
        player.map_vote_hold_t = 0;
    }

    fill := 0.0;
    if player.map_vote == index {
        fill = 1.0;
    } else if player.map_vote_hold_index == index {
        fill = clamp(player.map_vote_hold_t / MAP_VOTE_HOLD_SECONDS, 0.0, 1.0);
    }

    // Current map names fit on one line. A fixed compact title row keeps every
    // preview aligned without reserving an empty second line.
    line1, line2 := map_name_lines(map);
    title_box := UIK.layout_column();
    title_box.width = UIK.pixels(MAP_PREVIEW_WIDTH);
    title_box.height = UIK.pixels(58);
    title_box.gap = 0;
    title_box.cross_align = .CENTER;
    title_box.main_align = .CENTER;
    UIK.panel_begin(title_box);
    title_desc := UIK.text_title();
    title_desc.set_size_mult(1.0);
    title_desc.set_halign(.CENTER);
    UIK.text(title_desc, line1);
    UIK.panel_end();

    preview := UIK.layout_column();
    preview.width = UIK.pixels(MAP_PREVIEW_WIDTH);
    preview.height = UIK.pixels(MAP_PREVIEW_HEIGHT);
    preview.background = .MODAL_WHITE;
    preview.tint = v4.{0.04, 0.045, 0.055, 1};
    // Counter the modal nine-slice's built-in content inset so the artwork
    // reaches the rounded mask, leaving only a narrow dark outline.
    preview.padding = v4.{-7, -7, -7, -7};
    preview.clip_children = true;
    preview.mask_scope = true;
    UIK.panel_begin(preview);
    if map == .BACKROOMS {
        UIK.image_fitted(get_asset(Texture_Asset, "backroomsmap.png"), UIK.image_desc(.COVER));
    } else if map == .BACKROOMS_DARK {
        UIK.image_fitted(get_asset(Texture_Asset, "sandmaze.png"), UIK.image_desc(.COVER));
    } else if map == .BACKROOMS_WATER {
        UIK.image_fitted(get_asset(Texture_Asset, "poolroom.png"), UIK.image_desc(.COVER));
    } else if map == .ART_HEIST {
        UIK.image_fitted(get_asset(Texture_Asset, "artihiest.png"), UIK.image_desc(.COVER));
    } else if map == .CITY {
        UIK.image_fitted(get_asset(Texture_Asset, "citymap_image.png"), UIK.image_desc(.COVER));
    }
    UIK.panel_end();

    hint := "Click and hold to vote";
    if player.map_vote == index { hint = "Voted"; }
    hint_desc := UIK.text_body();
    hint_desc.set_size_mult(0.85);
    hint_desc.set_halign(.CENTER);
    UIK.text(hint_desc, hint);

    // Reserve the bar's slot in the card layout with an empty panel, then paint
    // it with flat quads from that slot's rect. The kit's nine-sliced panels bake
    // asymmetric margins into the black track and the green fill that never line
    // up (the offset you'd see otherwise); a flat white-sprite quad has none, so
    // the fill sits exactly inside the track. Same method the colour picker's
    // sliders use, and the engine's own progress bar (subrect(0,0,fill,1)).
    bar_slot := UIK.layout_row();
    bar_slot.width = UIK.pixels(MAP_PREVIEW_WIDTH);
    bar_slot.height = UIK.pixels(MAP_VOTE_BAR_HEIGHT);
    bar_res := UIK.panel_begin_interactive(`map_vote_bar_{index}`, bar_slot, false);
    UIK.panel_end();

    bar := bar_res.rect;
    if bar.max.x > bar.min.x {
        UI.push_screen_draw_context();
        defer UI.pop_draw_context();
        UI.push_layer(122);
        defer UI.pop_layer();
        UI.quad(bar, core_globals.white_sprite, MAP_VOTE_TRACK_COLOR);
        if fill > 0 {
            inner := bar.inset(MAP_VOTE_BAR_INSET);
            UI.quad(inner.subrect(0, 0, fill, 1), core_globals.white_sprite, MAP_VOTE_GREEN);
        }
    }

    votes_desc := UIK.text_title();
    votes_desc.set_size_mult(1.15);
    votes_desc.set_halign(.CENTER);
    votes_desc.set_color(MAP_VOTE_GREEN);
    UIK.text(votes_desc, `Votes: {game.map_votes[index]}`);
}

draw_map_vote_ui :: proc(player: Player, dt: float) {
    game := get_hide_seek_game();
    if !#alive(game) || game.phase != .MAP_SELECTION { return; }

    begin_desc := UIK.window(UI.get_safe_screen_rect());
    begin_desc.layer = 120;
    UIK.begin(begin_desc);
    defer UIK.end();

    column := UIK.layout_column();
    column.width = UIK.fit();
    column.height = UIK.fit();
    column.gap = 10;
    column.cross_align = .CENTER;
    UIK.overlay_begin(.CENTER, column, v2.{0, 0});
    defer UIK.overlay_end();

    row := UIK.layout_row(UIK.fit(), UIK.fit(), 16);
    row.cross_align = .START;
    UIK.panel_begin(row);
    for slot: 0..VOTE_CARD_COUNT - 1 {
        draw_map_vote_card(player, game, game.vote_map_indices[slot], dt);
    }
    UIK.panel_end();

    draw_uik_countdown(game);
    timer_desc := UIK.text_title();
    timer_desc.set_size_mult(1.35);
    timer_desc.set_halign(.CENTER);
    UIK.text(timer_desc, "Time left to vote");
}

draw_hide_seek_role_reveal :: proc(player: Player) {
    if get_time() >= player.role_reveal_end_time { return; }
    game := get_hide_seek_game();
    if !#alive(game) || game.phase != .HIDING { return; }

    remaining := max(0.0, player.role_reveal_end_time - get_time());
    progress := clamp(1.0 - remaining / ROLE_REVEAL_SECONDS, 0, 1);
    alpha := Ease.fade_in_and_out(0.1, 1.0, progress);
    slide := Ease.slide_in_and_out(0.1, 1.0, progress);

    role_title := "YOU ARE A HIDER";
    instruction := "Paint yourself to match the map, then hide before the timer runs out.";
    role_color := v4.{0.25, 1.0, 0.45, 1};
    if player.hide_seek_role == .SEEKER {
        role_title = "YOU ARE A SEEKER";
        instruction = "Wait in the lobby until the timer runs out, then hunt the hiders.";
        role_color = v4.{1.0, 0.18, 0.18, 1};
    }

    screen := UI.get_safe_screen_rect();
    UI.push_screen_draw_context();
    defer UI.pop_draw_context();
    UI.push_layer(140);
    defer UI.pop_layer();
    UI.push_color_multiplier(v4.{1, 1, 1, alpha});
    defer UI.pop_color_multiplier();

    UI.quad(screen, core_globals.white_sprite, v4.{0, 0, 0, 0.9});
    // Blocks taps from reaching the game underneath for the whole reveal. The
    // close button below only exists once the roll is over.
    UI.blocker(screen, "role reveal blocker");

    // The reel owns the middle of the screen. Name and instructions stay hidden
    // until it lands, so the result is not spoiled during the spin.
    settled := draw_role_reel(player, screen);
    if !settled {
        spin_rect := screen.center_rect().grow(40, 520, 40, 520).offset(0, 250);
        spin_settings := UI.default_text_settings();
        spin_settings.size = 44;
        spin_settings.color = v4.{1, 1, 1, 1};
        spin_settings.halign = .CENTER;
        spin_settings.valign = .CENTER;
        spin_settings.do_outline = true;
        spin_settings.outline_thickness = 5;
        spin_settings.outline_color = v4.{0, 0, 0, 1};
        UI.text(spin_rect, spin_settings, "ASSIGNING ROLE");
        return;
    }

    // "YOU ARE A SEEKER" lands right after the reel stops, punching in over a
    // short beat so it reads as the payoff of the roll rather than a caption
    // that was always there.
    settle_age := role_reel_settle_age(player);
    reveal_t := clamp((settle_age - ROLE_REEL_HOLD) / 0.32, 0, 1);
    reveal_ease := Ease.out_back(reveal_t);

    content := screen.offset(slide * 100.0, 0);
    title_rect := content.center_rect().grow(80, 520, 10, 520).offset(0, 250);
    title_settings := UI.default_text_settings();
    title_settings.size = 64 * lerp(0.55, 1.0, reveal_ease);
    title_settings.color = v4.{role_color.x, role_color.y, role_color.z, reveal_t};
    title_settings.halign = .CENTER;
    title_settings.valign = .CENTER;
    title_settings.do_outline = true;
    title_settings.outline_thickness = 6;
    title_settings.outline_color = v4.{0, 0, 0, reveal_t};
    UI.text(title_rect, title_settings, role_title);

    // The instruction follows a beat behind the role name.
    instruction_t := clamp((settle_age - ROLE_REEL_HOLD - 0.22) / 0.3, 0, 1);
    instruction_rect := screen.center_rect().offset(0, -260).grow(35, 400, 35, 400);
    instruction_settings := UI.default_text_settings();
    instruction_settings.size = 40;
    instruction_settings.color = v4.{1, 1, 1, instruction_t};
    instruction_settings.halign = .CENTER;
    instruction_settings.valign = .CENTER;
    instruction_settings.word_wrap = true;
    UI.text(instruction_rect, instruction_settings, instruction);

    // The timer bar and the close tap belong to the reveal, not the roll, so
    // they arrive with the role name instead of sitting under the spinning reel.
    if reveal_t <= 0 { return; }
    bar_bg := screen.bottom_center_rect().offset(0, 180).grow(14, 310, 14, 310);
    bar_inner := bar_bg.inset(4);
    bar_fill := bar_inner.subrect(0, 0, progress, 1);
    UI.quad(bar_bg, core_globals.white_sprite, v4.{0.78, 0.78, 0.82, reveal_t});
    UI.quad(bar_inner, core_globals.white_sprite, v4.{0.08, 0.08, 0.10, reveal_t});
    UI.quad(bar_fill, core_globals.white_sprite, v4.{role_color.x, role_color.y, role_color.z, reveal_t});

    bar_text := UI.default_text_settings();
    bar_text.size = 28;
    bar_text.color = v4.{1, 1, 1, reveal_t};
    bar_text.halign = .CENTER;
    bar_text.valign = .CENTER;
    UI.text(bar_bg.offset(0, 46), bar_text, "TAP TO CLOSE");

    close_bs := UI.default_button_settings();
    close_bs.sprite = core_globals.white_sprite;
    close_bs.color = v4.{0, 0, 0, 0};
    close_bs.hovered_color = v4.{0, 0, 0, 0};
    close_bs.pressed_color = v4.{0, 0, 0, 0};
    close_bs.disabled_color = v4.{0, 0, 0, 0};
    close_bs.press_scaling = 0;
    close_ts := UI.default_text_settings();
    UI.push_id("role reveal close");
    close_result := UI.button(screen, close_bs, close_ts, "");
    UI.pop_id();
    if close_result.just_pressed && remaining > 0.5 {
        player.role_reveal_end_time = get_time() + 0.5;
    }
}
