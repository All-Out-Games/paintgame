// Slot-machine reel for the role reveal. A vertical strip of HIDER/SEEKER tiles
// scrolls down past a center window and eases to a stop on the player's role.
//
// The whole animation is a pure function of (get_time() - role_roll_start_time)
// and the target index, so the client and the server draw identical frames and
// nothing has to be reconciled. The roll is decided up front - here the winner
// is the role the round already assigned, so the reel reveals a result rather
// than producing one.

ROLE_REEL_DURATION :: 1.46;
ROLE_REEL_REVOLUTIONS :: 6;
ROLE_REEL_SLOT_H :: 132.0;
ROLE_REEL_WIDTH :: 660.0;
ROLE_REEL_VISIBLE_RANGE :: 2;
ROLE_REEL_GLOW_TEXTURE :: "blinded_effect_889bd4.png";
ROLE_REEL_TICK_SFX :: "tick_4f7d58.wav";
ROLE_REEL_ITEM_COUNT :: 2;
ROLE_REEL_GLOW_SIZE :: 300.0;
// The pointer art that brackets the winning row.
ROLE_REEL_MARKER_TEXTURE :: "roll-selector.png";
ROLE_REEL_MARKER_WIDTH :: 150.0;
ROLE_REEL_MARKER_GAP :: 150.0;
ROLE_REEL_MARKER_RIGHT_ROTATION :: 180.0;
// After it lands the reel holds on the winner, then clears off so it is not
// sitting on top of the "YOU ARE A ..." screen.
ROLE_REEL_HOLD :: 0.41;
ROLE_REEL_FADE :: 0.26;

// Two reels run back to back: the role, then the game mode. The second starts
// once the first has cleared, so only one strip is ever on screen.
Reel_Kind :: enum {
    ROLE;
    MODE;
}

REEL_COLUMN_WIDTH :: 400.0;
REEL_COLUMN_GAP :: 36.0;
// The role column rolls alone and centred; once it lands and holds, the mode
// column slides in from the right and the role column shifts left to make room.
REEL_SLIDE_SECONDS :: 0.3;

// Index 0 and 1 are the two faces of each reel. Kept in lockstep with reel_target.
reel_item_label :: proc(kind: Reel_Kind, index: s64) -> string {
    if kind == .MODE {
        if index == 1 { return "FAT"; }
        return "INFECTION";
    }
    if index == 1 { return "SEEKER"; }
    return "HIDER";
}

// Reel-only palette: blue hider, red seeker, matching the reference art. The
// rest of the game keeps green for hiders.
reel_item_color :: proc(kind: Reel_Kind, index: s64) -> v4 {
    if kind == .MODE {
        if index == 1 { return v4.{1.0, 0.62, 0.16, 1}; }
        return v4.{0.42, 1.0, 0.45, 1};
    }
    if index == 1 { return v4.{1.0, 0.24, 0.24, 1}; }
    return v4.{0.29, 0.64, 1.0, 1};
}

reel_target :: proc(player: Player, kind: Reel_Kind) -> s64 {
    if kind == .MODE {
        game := get_hide_seek_game();
        if #alive(game) && game.game_mode == .FAT { return 1; }
        return 0;
    }
    if player.hide_seek_role == .SEEKER { return 1; }
    return 0;
}

reel_duration :: proc(kind: Reel_Kind) -> float {
    return ROLE_REEL_DURATION;
}

// The mode column starts once the role column has landed and held on its result.
reel_start_time :: proc(player: Player, kind: Reel_Kind) -> float {
    if kind == .MODE { return player.role_roll_start_time + ROLE_REEL_DURATION + ROLE_REEL_HOLD; }
    return player.role_roll_start_time;
}

// 0 while the role column still has the screen to itself, 1 once the machine has
// fully opened out into two columns.
reel_slide_t :: proc(player: Player) -> float {
    elapsed := get_time() - reel_start_time(player, .MODE);
    return Ease.out_cubic(clamp(elapsed / REEL_SLIDE_SECONDS, 0, 1));
}

// Called wherever a role reveal is armed, so the reel and the reveal share a
// start time.
trigger_role_roll :: proc(player: Player) {
    player.role_roll_start_time = get_time();
    // Kept for reference/debugging; the reels read their targets live from the
    // role and game mode, which are already settled by the time this is armed.
    player.role_roll_target = reel_target(player, .ROLE);
    player.role_roll_last_tick = -1;
}

reel_progress :: proc(player: Player, kind: Reel_Kind) -> float {
    if player.role_roll_start_time <= 0 { return 1.0; }
    elapsed := get_time() - reel_start_time(player, kind);
    return clamp(elapsed / reel_duration(kind), 0.0, 1.0);
}

// Strip index currently centered in the window. Everything the reel draws hangs
// off this one number.
reel_scroll :: proc(player: Player, kind: Reel_Kind) -> float, s64 {
    progress := reel_progress(player, kind);
    n_items := ROLE_REEL_ITEM_COUNT.(float);
    scroll_final := (ROLE_REEL_REVOLUTIONS.(float) * n_items + reel_target(player, kind).(float) + 0.5) * ROLE_REEL_SLOT_H;

    inv := 1.0 - progress;
    eased := 1.0 - inv * inv * inv;
    scroll := eased * scroll_final;
    base_k := (scroll / ROLE_REEL_SLOT_H).(s64);
    return scroll, base_k;
}

// Ticks live in the sim update, not the draw, so last_tick survives server
// reconcile. Because the scroll eases out, the ticks slow to a crawl on their
// own as the reel settles.
update_role_reel :: proc(player: Player) {
    if player.role_roll_start_time <= 0 { return; }
    kind := Reel_Kind.ROLE;
    if reel_progress(player, .ROLE) >= 1.0 { kind = .MODE; }
    if reel_progress(player, kind) >= 1.0 { return; }
    if get_time() < reel_start_time(player, kind) { return; }

    _, base_k := reel_scroll(player, kind);
    // Offset the mode reel's tick key so the two reels cannot share a value and
    // silence each other's first tick.
    tick_key := base_k;
    if kind == .MODE { tick_key += 100000; }
    if tick_key == player.role_roll_last_tick { return; }
    player.role_roll_last_tick = tick_key;

    desc := SFX.default_sfx_desc();
    desc.specific_to_player = player;
    desc.volume = 0.35;
    desc.speed_perturb = 0.04;
    SFX.play(get_asset(SFX_Asset, ROLE_REEL_TICK_SFX), desc);
}

// True once every player taking part in the round has seen their reel land.
// Lobby waiters are not in the round, so they never hold it up.
hide_seek_all_rolls_revealed :: proc() -> bool {
    for player: component_iterator(Player) {
        if player.hide_seek_role == .LOBBY || player.hide_seek_role == .NONE { continue; }
        if !role_reel_revealed(player) { return false; }
    }
    return true;
}

// True once the reel has landed and held on the winner - the moment the role is
// actually known to the player, and so the moment it is fair to move them.
role_reel_revealed :: proc(player: Player) -> bool {
    return role_reel_settle_age(player) >= ROLE_REEL_HOLD;
}

// The two glowing white bars that flank the winning row, marking which line of
// the strip counts. Drawn as a soft wide glow with a bright core on top.
// Brackets the machine's current extent - one column while the role is rolling,
// both once the mode column has slid in.
draw_role_reel_markers :: proc(machine_left: float, machine_right: float, center_y: float, alpha: float) {
    marker := get_asset(Texture_Asset, ROLE_REEL_MARKER_TEXTURE);
    if marker == null { return; }

    half_w := ROLE_REEL_MARKER_WIDTH * 0.5;
    left_x := machine_left - ROLE_REEL_MARKER_GAP - half_w;
    right_x := machine_right + ROLE_REEL_MARKER_GAP + half_w;
    half_h := half_w / max(0.0001, marker.get_aspect());

    left := Rect.{
        min = v2.{left_x - half_w, center_y - half_h},
        max = v2.{left_x + half_w, center_y + half_h},
    };
    right := Rect.{
        min = v2.{right_x - half_w, center_y - half_h},
        max = v2.{right_x + half_w, center_y + half_h},
    };

    tint := v4.{1, 1, 1, alpha};
    UI.quad(left, marker, tint);
    UI.push_matrix(Matrix4.rotate_about_point(right.center(), ROLE_REEL_MARKER_RIGHT_ROTATION));
    UI.quad(right, marker, tint);
    UI.pop_matrix();
}

// Seconds since a given reel stopped. Negative while it is still spinning. With
// no roll armed it reports long settled, so the reveal text shows immediately
// rather than fading in from an animation that never ran.
reel_settle_age :: proc(player: Player, kind: Reel_Kind) -> float {
    if player.role_roll_start_time <= 0 { return 999.0; }
    return get_time() - reel_start_time(player, kind) - reel_duration(kind);
}

// Age of the whole sequence, measured from the last reel landing and holding.
// This is what gates the reveal text and the round start.
role_reel_settle_age :: proc(player: Player) -> float {
    return reel_settle_age(player, .MODE);
}

// Two columns side by side, slot-machine style: both start spinning together and
// stop left to right, the role column first and the mode column REEL_STAGGER
// later. Returns true once the last column has landed, held and faded.
draw_role_reel :: proc(player: Player, screen: Rect) -> bool {
    if player.role_roll_start_time <= 0 { return true; }

    role_window := reel_window(player, screen, .ROLE);
    draw_one_reel(player, screen, .ROLE);

    done := false;
    right_edge := role_window.max.x;
    mode_started := get_time() >= reel_start_time(player, .MODE);
    if mode_started {
        done = draw_one_reel(player, screen, .MODE);
        right_edge = reel_window(player, screen, .MODE).max.x;
    }

    // One marker pair brackets whatever the machine currently spans, so the
    // winning row reads as a single line whether there are one or two columns.
    _, sequence_alpha := reel_alphas(player, .MODE);
    if sequence_alpha > 0 {
        draw_role_reel_markers(role_window.min.x, right_edge, role_window.center().y, sequence_alpha);
    }
    return done;
}

// Both columns fade together off the last one to land, so a column that has
// already stopped keeps showing its result while the other is still spinning.
reel_alphas :: proc(player: Player, kind: Reel_Kind) -> float, float {
    sequence_age := reel_settle_age(player, .MODE);
    sequence_alpha := 1.0 - clamp((sequence_age - ROLE_REEL_HOLD) / ROLE_REEL_FADE, 0, 1);
    // The losing faces of a column drop away as soon as that column lands.
    own_age := reel_settle_age(player, kind);
    neighbor_alpha := sequence_alpha * (1.0 - clamp(own_age / 0.2, 0, 1));
    return neighbor_alpha, sequence_alpha;
}

// Column geometry, animated by the slide. The role column starts centred and
// moves left; the mode column comes in from off the right edge.
reel_window :: proc(player: Player, screen: Rect, kind: Reel_Kind) -> Rect {
    center := screen.center();
    center_y := center.y + 30;
    offset := (REEL_COLUMN_WIDTH + REEL_COLUMN_GAP) * 0.5;
    slide := reel_slide_t(player);

    center_x := lerp(center.x, center.x - offset, slide);
    if kind == .MODE {
        center_x = lerp(screen.max.x + REEL_COLUMN_WIDTH, center.x + offset, slide);
    }
    half_w := REEL_COLUMN_WIDTH * 0.5;
    return Rect.{
        min = v2.{center_x - half_w, center_y - ROLE_REEL_SLOT_H * 1.5},
        max = v2.{center_x + half_w, center_y + ROLE_REEL_SLOT_H * 1.5},
    };
}

draw_one_reel :: proc(player: Player, screen: Rect, kind: Reel_Kind) -> bool {
    progress := reel_progress(player, kind);
    scroll, base_k := reel_scroll(player, kind);
    settled := progress >= 1.0;

    settle_age := reel_settle_age(player, kind);
    neighbor_alpha, reel_alpha := reel_alphas(player, kind);
    if reel_alpha <= 0 { return true; }

    window := reel_window(player, screen, kind);
    center := window.center();
    center_y := center.y;

    // No frame or tile plates - the labels float over the dimmed scene. The
    // scissor still clips the strip so tiles fade out instead of running into
    // the reveal text above and below.
    UI.push_scissor(window);
    defer UI.pop_scissor();

    for off: -ROLE_REEL_VISIBLE_RANGE..ROLE_REEL_VISIBLE_RANGE {
        k := base_k + off;
        if k < 0 { continue; }
        idx := k % ROLE_REEL_ITEM_COUNT;
        if idx < 0 { idx += ROLE_REEL_ITEM_COUNT; }

        tile_strip_y := (k.(float) + 0.5) * ROLE_REEL_SLOT_H;
        screen_y := center_y - (tile_strip_y - scroll);

        // Fake perspective: tiles shrink and fade with distance from the window
        // center, which is what makes the strip read as a physical reel.
        d := abs(off);
        scale := 1.0;
        tile_alpha := 1.0;
        if d == 1 {
            scale = 0.82;
            tile_alpha = 0.65;
        } else if d >= 2 {
            scale = 0.6;
            tile_alpha = 0.3;
        }
        if d == 0 {
            tile_alpha *= reel_alpha;
        } else {
            tile_alpha *= neighbor_alpha;
        }
        if tile_alpha <= 0 { continue; }

        color := reel_item_color(kind, idx);
        tile_h := ROLE_REEL_SLOT_H * scale;
        tile_w := (REEL_COLUMN_WIDTH - 24) * scale;
        tile := Rect.{
            min = v2.{center.x - tile_w * 0.5, screen_y - tile_h * 0.5},
            max = v2.{center.x + tile_w * 0.5, screen_y + tile_h * 0.5},
        };

        if d == 0 {
            pop := 0.0;
            if settled {
                pop = sin(min(1.0, settle_age * 6.0) * PI) * 0.12;
            }
            grow_x := tile.width() * pop * 0.5;
            grow_y := tile.height() * pop * 0.5;
            tile = tile.grow(grow_y, grow_x, grow_y, grow_x);
            // The glow behind the center slot is what sells the landing.
            // Sized off the tile center and fitted to the texture's own aspect -
            // stretching the radial glow across the full tile width smears it.
            glow_tex := get_asset(Texture_Asset, ROLE_REEL_GLOW_TEXTURE);
            glow_half := ROLE_REEL_GLOW_SIZE * 0.5 * (1.0 + pop);
            glow_rect := Rect.{
                min = tile.center() - v2.{glow_half, glow_half},
                max = tile.center() + v2.{glow_half, glow_half},
            };
            UI.quad(glow_rect.fit_aspect(glow_tex.get_aspect()), glow_tex, v4.{color.x, color.y, color.z, 0.75 * reel_alpha});
        }

        label := UI.default_text_settings();
        // "INFECTION" is the longest face; sized so it fits a column without
        // being clipped by the scissor.
        label.size = 58 * scale;
        label.color = v4.{color.x, color.y, color.z, tile_alpha};
        label.halign = .CENTER;
        label.valign = .CENTER;
        label.do_outline = true;
        label.outline_thickness = 5;
        label.outline_color = v4.{0, 0, 0, tile_alpha};
        UI.text(tile, label, reel_item_label(kind, idx));
    }

    // Caption above the strip, so it is clear which of the two things is being
    // rolled. Sits outside the scissor so it is never clipped.
    UI.pop_scissor();
    caption := "YOUR ROLE";
    if kind == .MODE { caption = "GAME MODE"; }
    caption_settings := UI.default_text_settings();
    caption_settings.size = 38;
    caption_settings.color = v4.{1, 1, 1, 0.85 * reel_alpha};
    caption_settings.halign = .CENTER;
    caption_settings.valign = .CENTER;
    caption_settings.do_outline = true;
    caption_settings.outline_thickness = 4;
    caption_settings.outline_color = v4.{0, 0, 0, reel_alpha};
    caption_rect := Rect.{
        min = v2.{window.min.x, window.max.y + 6},
        max = v2.{window.max.x, window.max.y + 58},
    };
    UI.text(caption_rect, caption_settings, caption);
    UI.push_scissor(window);

    // Only the last reel finishing ends the sequence.
    if kind != .MODE { return false; }
    return settle_age >= ROLE_REEL_HOLD + ROLE_REEL_FADE;
}
