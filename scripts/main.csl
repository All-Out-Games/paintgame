import "core:ao"
import "reusable_weapons"

// Game wide systems
ao_before_scene_load :: proc() {
}

ao_start :: proc() {
    init_weapon_items();
    paint_it := component_iterator(Paint_Demo);
    if !paint_it.next() {
        e := Scene.create_entity();
        e.set_name("Paint Demo Manager");
        e.add_component(Paint_Demo);
    }
    // Hide_Seek_Game lives on the GameManager scene entity so its spawn
    // references can be assigned in the editor. This only builds a fallback if
    // that entity is missing, and that fallback has no spawns wired up.
    hide_seek_it := component_iterator(Hide_Seek_Game);
    if !hide_seek_it.next() {
        e := Scene.create_entity();
        e.set_name("Hide Seek Game");
        e.add_component(Hide_Seek_Game);
    }
}

ao_update :: proc(dt: float) {
}

ao_late_update :: proc(dt: float) {
}

// Per player state
Player :: class : Player_Base {
    brush_color:   v4;
    last_paint_px: v2;
    was_painting:  bool;
    wear_delay:    float;
    skin_initialized: bool;
    skin_canvas:   Dynamic_Canvas;
    last_scene_sample_serial: u64;
    wear_paint_enabled: bool;
    rig_swapped:   bool;
    mecha_skin_applied: bool;
    locomotion_ready: bool;

    // HSV colour picker (toggle with P). brush_color is derived from these on
    // interaction. See draw_color_picker in paint_demo.csl.
    picker_open: bool;
    paint_mode: bool;
    paint_controls_disabled: bool;
    emotes_open: bool;
    active_pose: s64;
    pre_paint_zoom_t: float;
    pre_paint_camera_size: float;
    picker_h:    float;
    picker_s:    float;
    picker_v:    float;
    brush_radius: float;   // texels; set by the picker's brush-size slider
    eyedropper_active: bool;  // armed by the picker's PICK button; next scene click samples
    paint_cursor_interp: Position_Interpolation_Helper;
    paint_undo_pixels: [..]Paint_Undo_Pixel;
    paint_undo_recorded: [SKIN_TEXELS_X * SKIN_TEXELS_Y]bool;

    // Right-side camera zoom slider (see zoom_slider.csl).
    zoom_initialized: bool;
    zoom_base_size:   float;  // scene default camera ortho size, captured once
    zoom_t:           float;  // 0 = zoomed out, 1 = zoomed in

    // Spine attachment override ids while wearing the painted canvas (B key).
    // One per painted attachment, see PAINTED_ATTACHMENT_COUNT.
    override_ids: [PAINTED_ATTACHMENT_COUNT]u64;

    // Hide and seek round state.
    hide_seek_role: Hide_Seek_Role;
    role_visual_applied: Hide_Seek_Role;
    spawn_placed: bool;   // set once the game has positioned this player
    score: s64;             // live, ticks every frame
    published_score: s64;   // snapshot the leaderboard renders
    proximity_timer: float; // seconds banked toward the next point
    weapon_target: Weapon_Target;
    equipped_weapon_type: Weapon_Type;
    equipped_item_def: Item_Definition;
    last_selected_index: s64;
    boomwheel_cannon: Boomwheel_Cannon;
    weapon_state_ready: bool;
    seeker_rig_ready: bool;
    streamed_seeker_rig_ready: bool;
    lobby_start_position: v2;
    map_vote: s64;              // index into Map_Kind; -1 means no vote cast
    map_vote_hold_index: s64;   // card currently being held; -1 when none
    map_vote_hold_t: float;
    role_reveal_end_time: float;
    hider_name_hidden: bool;
    original_player_skins: [..]string;
    original_player_skins_captured: bool;

    ao_start :: method() {
        brush_color = v4.{0.9, 0.15, 0.15, 1};
        lobby_start_position = entity.world_position;
        map_vote = -1;
        map_vote_hold_index = -1;
        skin_canvas = Dynamic_Canvas.create(SKIN_TEXELS_X, SKIN_TEXELS_Y, 32);
        wear_paint_enabled = true;
        picker_open = false;
        paint_mode = false;
        picker_h = 0.0;
        picker_s = 1.0;
        picker_v = 1.0;
        brush_radius = 6.0;
        weapon_target = entity.add_component(Weapon_Target);
        weapon_target.health = 100.0;
        weapon_target.max_health = 100.0;
        weapon_target.owner_entity_id = entity.id;
        weapon_target.on_damaged_userdata = this;
        weapon_target.on_damaged = on_hide_seek_player_damaged;
        capture_original_player_skins(this);
        // Swap to the Mecha silhouette rig. Retried from ao_update if the
        // animator isn't ready yet.
        if hide_seek_role != .SEEKER {
            ensure_mecha_rig(this);
        }
        update_hide_seek_player(this);
    }

    ao_update :: method(dt: float) {
        // Painting runs through normal client prediction and server
        // reconciliation. Canvas pixels, worn attachment overrides, and the
        // sampled colors are all ordinary scene/input state.
        capture_original_player_skins(this);
        if hide_seek_role != .SEEKER {
            ensure_mecha_rig(this);
        }
        update_hide_seek_player(this);
        if hide_seek_role != .SEEKER && locomotion_ready {
            // The engine's built-in `moving` value is derived from position
            // delta. For remote players in a deployed game, their simulation
            // position advances at snapshot cadence, which makes that value
            // pulse on and off and restarts locomotion. Input intent is present
            // on every simulated frame, including remote-player resimulation.
            animator.state_machine.set_bool("mecha_moving", length_squared(input_this_frame) > 0.0001);
            animator.state_machine.set_int("mecha_pose", active_pose);
        }
        it := component_iterator(Paint_Demo);
        if !it.next() { return; }
        it.current.handle_paint_input(this, dt);
    }

    ao_late_update :: method(dt: float) {
        // UI must be drawn from player late_update, gated on is_local_or_server.
        if is_local_or_server() {
            draw_paint_mode_button(this);
            draw_emote_menu(this);
            draw_hide_seek_ui(this);
            draw_hide_seek_leaderboard(this);
            draw_map_vote_ui(this, dt);
            draw_hide_seek_role_reveal(this);
            if paint_mode && picker_open {
                draw_color_picker(this);
                draw_paint_undo_button(this);
            }
            if paint_mode {
                draw_zoom_slider(this);
                draw_paint_cursor(this);
            }
            if hide_seek_role == .SEEKER && hide_seek_can_shoot() {
                draw_ability_button(this, Catch_Ability, 0);
            } else if hide_seek_role == .HIDER && hide_seek_round_active() {
                draw_ability_button(this, Whistle_Ability, 0);
            }
        }
    }

    ao_end :: method() {
        if skin_canvas != null { skin_canvas.destroy(); }
    }

    ao_can_use_ability :: method(ability: Ability_Base) -> bool {
        if ability.#type == Whistle_Ability {
            return hide_seek_role == .HIDER && hide_seek_round_active();
        }
        return hide_seek_role == .SEEKER && hide_seek_can_shoot();
    }

    ao_can_use_interactable :: method(interactable: Interactable) -> bool {
        return true;
    }

    ao_on_state_sync :: method() {
    }
}
