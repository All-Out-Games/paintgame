// Right-side vertical zoom slider, ported from the plusonemineperclick project's
// ZoomSliderUI. Drag the handle up to zoom in, down to zoom out. Drives the local
// player's camera orthographic size (smaller size = zoomed in).
//
// The C# original read the raw mouse Y (top-down screen space). CSL legacy UI is
// Y-up, so this uses the hit button's Interact_Result.mouse_position instead - it
// arrives in the same space as the UI rects, so no manual axis juggling.

ZOOM_MIN_MUL  :: 0.25;  // top of the slider   - most zoomed in  (smallest ortho size)
ZOOM_MAX_MUL  :: 1.6;   // bottom of the slider - most zoomed out (largest ortho size)
ZOOM_HANDLE_R :: 22.0;  // handle half-size, 1080p-reference px

draw_zoom_slider :: proc(player: Player) {
    // Capture the scene's default camera size once as the neutral (mid) zoom.
    if !player.zoom_initialized && player.camera.size > 0 {
        player.zoom_base_size = player.camera.size;
        player.zoom_t = 0.5;
        player.zoom_initialized = true;
    }
    if !player.zoom_initialized { return; }

    UI.push_screen_draw_context();
    defer UI.pop_draw_context();
    UI.push_layer(100);
    defer UI.pop_layer();

    // Keep the original rail geometry as an invisible drag target. UIDoc owns
    // the bar and knob visuals.
    panel := UI.get_safe_screen_rect().right_center_rect().grow(160, 0, 160, 80).offset(-10, 0);

    // The green track region inside the bar art that the handle slides along.
    track := panel.inset(80, 24, 50, 24).offset(0, 10);

    // Invisible hit button - mouse_position comes back in UI space (Y up).
    bs := UI.default_button_settings();
    bs.sprite         = core_globals.white_sprite;
    bs.color          = v4.{0, 0, 0, 0};
    bs.hovered_color  = v4.{0, 0, 0, 0};
    bs.pressed_color  = v4.{0, 0, 0, 0};
    bs.disabled_color = v4.{0, 0, 0, 0};
    bs.press_scaling  = 0;
    ts := UI.default_text_settings();
    UI.push_id("zoom_slider");
    res := UI.button(track, bs, ts, "");
    UI.pop_id();

    // Keep the handle inset from the track ends so it never clips out. Constants
    // are 1080p-reference, so scale before mixing with the already-scaled rect.
    hr := ZOOM_HANDLE_R * UI.get_current_scale_factor();
    usable_min_y := track.min.y + hr;   // bottom = zoom out
    usable_max_y := track.max.y - hr;   // top    = zoom in
    usable_h := max(1.0, usable_max_y - usable_min_y);

    if res.active {
        player.zoom_t = clamp((res.mouse_position.y - usable_min_y) / usable_h, 0, 1);
    }

    // Apply to the local camera, eased for smoothness. t=1 (top) -> min size.
    target_size := lerp(player.zoom_base_size * ZOOM_MAX_MUL, player.zoom_base_size * ZOOM_MIN_MUL, player.zoom_t);
    player.camera.size = lerp(player.camera.size, target_size, 0.2);

}
